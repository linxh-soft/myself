def auto_detect_forming_c_ref(ref_atoms):
    ad = atom_dict(ref_atoms)
    oxy = [ad[i] for i in REACTIVE_O]
    carbons = [a for a in heavy_substrate(ref_atoms) if a["element"] == "C"]
    if len(carbons) < 2:
        raise RuntimeError("Fewer than two substrate carbon atoms found")

    best = None
    for i in range(len(carbons)):
        for j in range(i + 1, len(carbons)):
            c1, c2 = carbons[i], carbons[j]
            s1 = distance(oxy[0], c1) + distance(oxy[1], c2)
            s2 = distance(oxy[0], c2) + distance(oxy[1], c1)
            score = min(s1, s2)
            if best is None or score < best[0]:
                best = (score, c1["index"], c2["index"])
    return (best[1], best[2])


def forming_bond_descriptors(atoms, mapping, forming_c_ref):
    ad = atom_dict(atoms)
    cA_ref, cB_ref = forming_c_ref
    cA = mapping[cA_ref]
    cB = mapping[cB_ref]

    if FORMING_O_FOR_REF_C is not None:
        missing = [c for c in forming_c_ref if c not in FORMING_O_FOR_REF_C]
        if missing:
            raise RuntimeError(
                "FORMING_O_FOR_REF_C missing reference carbon(s): " +
                ", ".join(map(str, missing))
            )
        oA = FORMING_O_FOR_REF_C[cA_ref]
        oB = FORMING_O_FOR_REF_C[cB_ref]
        if oA == oB:
            raise RuntimeError("The two primary C-O pairs cannot use the same oxygen atom")
        pairing_mode = "manual_fixed"
        swapped = int((oA, oB) == (REACTIVE_O[1], REACTIVE_O[0]))
    else:
        o1, o2 = REACTIVE_O
        d11 = distance(ad[o1], ad[cA])
        d22 = distance(ad[o2], ad[cB])
        d12 = distance(ad[o1], ad[cB])
        d21 = distance(ad[o2], ad[cA])

        if d11 + d22 <= d12 + d21:
            oA, oB = o1, o2
            swapped = 0
        else:
            oA, oB = o2, o1
            swapped = 1
        pairing_mode = "auto_shorter_total_distance"

    dA = distance(ad[oA], ad[cA])
    dB = distance(ad[oB], ad[cB])
    short_d, long_d = sorted((dA, dB))

    occo_signed = dihedral_deg(ad[oA], ad[cA], ad[cB], ad[oB])
    if math.isnan(occo_signed):
        occo_abs = float("nan")
        occo_twist = float("nan")
    else:
        occo_abs = abs(occo_signed)
        occo_twist = min(occo_abs, 180.0 - occo_abs)

    return {
        "ref_C1": cA_ref,
        "ref_C2": cB_ref,
        "mapped_C1": cA,
        "mapped_C2": cB,
        "O_on_C1": oA,
        "O_on_C2": oB,
        "C1O_distance_A": dA,
        "C2O_distance_A": dB,
        "pairing_mode": pairing_mode,
        "pairing_swapped": swapped,
        "CO_short_A": short_d,
        "CO_long_A": long_d,
        "CO_mean_A": 0.5 * (short_d + long_d),
        "CO_sum_A": short_d + long_d,
        "CO_asym_A": long_d - short_d,
        "OCCO_dihedral_signed_deg": occo_signed,
        "OCCO_dihedral_abs_deg": occo_abs,
        "OCCO_twist_from_coplanar_deg": occo_twist,
        "primary_pairs": {(cA, oA), (cB, oB)},
    }


