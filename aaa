# LIGAND METHYL-GROUP ANALYSIS
# ============================================================

def centroid_from_atoms(atom_list):
    if not atom_list:
        return (float("nan"), float("nan"), float("nan"))
    n = float(len(atom_list))
    return (
        sum(a["x"] for a in atom_list) / n,
        sum(a["y"] for a in atom_list) / n,
        sum(a["z"] for a in atom_list) / n,
    )


def midpoint_atoms(a, b):
    return (
        0.5 * (a["x"] + b["x"]),
        0.5 * (a["y"] + b["y"]),
        0.5 * (a["z"] + b["z"]),
    )


def point_distance(p, q):
    return math.sqrt(
        (p[0] - q[0]) ** 2 +
        (p[1] - q[1]) ** 2 +
        (p[2] - q[2]) ** 2
    )


def atom_point(a):
    return (a["x"], a["y"], a["z"])


def ligand_neighbors(atoms, center_idx):
    """Infer covalent neighbors of one ligand atom using the same BOND_SCALE."""
    ad = atom_dict(atoms)
    if center_idx not in ad:
        raise RuntimeError(f"Missing atom index {center_idx}")
    c = ad[center_idx]
    neigh = []
    for a in atoms:
        if a["index"] == center_idx:
            continue
        # For methyl identification, only bonds within the ligand are relevant.
        if not (LIG_START <= a["index"] <= LIG_END):
            continue
        if distance(c, a) <= bond_cutoff(c["element"], a["element"]):
            neigh.append(a)
    return neigh


def find_ligand_methyl_candidates(atoms):
    """
    Detect ligand methyl carbons as ligand C atoms bonded to exactly 3 H atoms
    and exactly 1 non-H ligand atom under the connectivity cutoff.

    This is only an atom-index helper. The script never assigns chemical labels
    such as quinoline_Me or pyridine_Me automatically.
    """
    out = []
    for a in atoms:
        if not (LIG_START <= a["index"] <= LIG_END):
            continue
        if a["element"] != "C":
            continue
        neigh = ligand_neighbors(atoms, a["index"])
        hs = sorted(x["index"] for x in neigh if x["element"] == "H")
        heavy = [x for x in neigh if x["element"] != "H"]
        if len(hs) == 3 and len(heavy) == 1:
            out.append({
                "center_idx": a["index"],
                "H_indices": hs,
                "anchor_idx": heavy[0]["index"],
                "anchor_element": heavy[0]["element"],
            })
    out.sort(key=lambda x: x["center_idx"])
    return out


def resolve_methyl_groups(ref_atoms):
    """
    Resolve user-specified methyl centers against detected ligand methyl groups.

    Returns:
      resolved[label] = candidate metadata
      candidates      = all detected methyl candidates

    Unspecified labels (None) are intentionally left unresolved rather than
    guessed from atom order.
    """
    candidates = find_ligand_methyl_candidates(ref_atoms)
    by_center = {x["center_idx"]: x for x in candidates}
    resolved = {}

    used = set()
    for label, idx in METHYL_CENTERS.items():
        if idx is None:
            continue
        if idx in used:
            raise RuntimeError(f"Methyl carbon C{idx} assigned to more than one label")
        if idx not in by_center:
            raise RuntimeError(
                f"Configured {label}=C{idx}, but C{idx} was not detected as a ligand CH3 carbon. "
                f"Detected candidates: {sorted(by_center)}"
            )
        resolved[label] = dict(by_center[idx])
        used.add(idx)

    return resolved, candidates




def heavy_ligand(atoms):
    """All non-H ligand atoms in the configured ligand index block."""
    return [
        a for a in atoms
        if LIG_START <= a["index"] <= LIG_END and a["element"] != "H"
    ]


def build_ligand_graph(atoms):
    """Connectivity graph for ligand heavy atoms only."""
    heavy = heavy_ligand(atoms)
    graph = {a["index"]: set() for a in heavy}
    adict = {a["index"]: a for a in heavy}
    for i in range(len(heavy)):
        for j in range(i + 1, len(heavy)):
            a, b = heavy[i], heavy[j]
            if distance(a, b) <= bond_cutoff(a["element"], b["element"]):
                graph[a["index"]].add(b["index"])
                graph[b["index"]].add(a["index"])
    return graph, adict


def best_ligand_mapping(ref_atoms_all, target_atoms_all):
    """
    Graph-map REFERENCE ligand heavy atoms onto a target structure.

    The mapping is chosen by the same internal-distance-matrix RMS criterion
    used for the substrate. This does NOT require matching atom numbers.
    """
    rg, ra = build_ligand_graph(ref_atoms_all)
    tg, ta = build_ligand_graph(target_atoms_all)
    mappings = find_mappings(rg, ra, tg, ta)
    if not mappings:
        raise RuntimeError("No ligand heavy-atom graph mapping found")
    scored = [(distance_matrix_rms(m, ra, ta), m) for m in mappings]
    scored.sort(key=lambda x: x[0])
    return scored[0][1], scored[0][0], len(mappings)


def map_named_methyls_to_structures(structures, ref_methyl_meta_by_label):
    """
    Map named methyl groups defined in REFERENCE numbering onto every structure.

    Returns
    -------
    methyl_meta_by_structure[name][label] : metadata in that structure's numbering
    ligand_mapping_meta[name] : (distance_matrix_rms_A, n_graph_mappings)
    ligand_mappings[name] : heavy-atom map ref_index -> target_index
    """
    ref_atoms = structures[REFERENCE]
    ref_graph, _ = build_ligand_graph(ref_atoms)
    ligand_mappings = {REFERENCE: {i: i for i in ref_graph}}
    ligand_mapping_meta = {REFERENCE: (0.0, 1)}
    methyl_meta_by_structure = {}

    for name, atoms in structures.items():
        if name != REFERENCE:
            m, score, nmaps = best_ligand_mapping(ref_atoms, atoms)
            ligand_mappings[name] = m
            ligand_mapping_meta[name] = (score, nmaps)

        candidate_by_center = {
            x["center_idx"]: x for x in find_ligand_methyl_candidates(atoms)
        }
        mapped = {}
        for label, ref_meta in ref_methyl_meta_by_label.items():
            ref_center = ref_meta["center_idx"]
            target_center = ligand_mappings[name][ref_center]
            if target_center not in candidate_by_center:
                raise RuntimeError(
                    f"{name}: reference {label} C{ref_center} mapped to C{target_center}, "
                    "but that atom is not detected as a CH3 carbon in the target structure."
                )
            meta = dict(candidate_by_center[target_center])
            meta["reference_center_idx"] = ref_center
            meta["reference_anchor_idx"] = ref_meta["anchor_idx"]
            mapped[label] = meta
        methyl_meta_by_structure[name] = mapped

    return methyl_meta_by_structure, ligand_mapping_meta, ligand_mappings


def write_methyl_mapping_report(methyl_meta_by_structure, ligand_mapping_meta):
    fields = [
        "structure", "methyl_label",
        "reference_methyl_center", "mapped_methyl_center",
        "mapped_attached_H_atoms", "mapped_anchor_atom", "mapped_anchor_element",
        "ligand_mapping_distance_matrix_RMS_A", "n_ligand_graph_mappings",
    ]
    rows = []
    for name, by_label in methyl_meta_by_structure.items():
        score, nmaps = ligand_mapping_meta[name]
        for label, meta in by_label.items():
            rows.append({
                "structure": name,
                "methyl_label": label,
                "reference_methyl_center": meta["reference_center_idx"],
                "mapped_methyl_center": meta["center_idx"],
                "mapped_attached_H_atoms": ";".join(map(str, meta["H_indices"])),
                "mapped_anchor_atom": meta["anchor_idx"],
                "mapped_anchor_element": meta["anchor_element"],
                "ligand_mapping_distance_matrix_RMS_A": score,
                "n_ligand_graph_mappings": nmaps,
            })
    with open(METHYL_MAPPING_OUT, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=fields)
        w.writeheader()
        for row in rows:
            w.writerow({k: fmt(v) for k, v in row.items()})


def methyl_group_atoms(atoms, methyl_meta):
    """Return CH3 atoms: methyl carbon + its three attached H atoms."""
    ad = atom_dict(atoms)
    ids = [methyl_meta["center_idx"]] + list(methyl_meta["H_indices"])
    missing = [i for i in ids if i not in ad]
    if missing:
        raise RuntimeError(f"Missing methyl-group atoms: {missing}")
    return [ad[i] for i in ids]


def methyl_group_descriptors(atoms, methyl_meta, forming_info, phenyl_ring_indices):
    """
    Geometry of one ligand methyl group relative to the substrate.

    Contact quantities are neutral vdW-proximity descriptors, not energetic
    penalties.  The forming-C midpoint is retained as a reaction-coordinate
    reference, but phenyl-ring centroid/plane descriptors are the preferred
    measures for the two methyl groups vs substrate conformation.
    """
    ad = atom_dict(atoms)
    mC = ad[methyl_meta["center_idx"]]
    group_atoms = methyl_group_atoms(atoms, methyl_meta)

    subheavy_idx = [a["index"] for a in heavy_substrate(atoms)]
    suball_idx = [a["index"] for a in substrate_atoms(atoms)]

    ch3_to_subheavy = build_contact_list(atoms, subheavy_idx, group_atoms)
    ch3_to_suball = build_contact_list(atoms, suball_idx, group_atoms)

    sh_summary = summarize_contacts(ch3_to_subheavy)
    sa_summary = summarize_contacts(ch3_to_suball)

    c1 = ad[forming_info["mapped_C1"]]
    c2 = ad[forming_info["mapped_C2"]]
    rxn_mid = midpoint_atoms(c1, c2)
    subheavy_centroid = centroid_from_atoms(heavy_substrate(atoms))

    phenyl_atoms = [ad[i] for i in phenyl_ring_indices]
    phenyl_centroid, phenyl_normal = ring_centroid_and_normal(atoms, phenyl_ring_indices)
    ch3_to_phenylC = build_contact_list(atoms, phenyl_ring_indices, group_atoms)
    phenyl_summary = summarize_contacts(ch3_to_phenylC)

    # Closest substrate contact involving any CH3 atom.
    closest = ch3_to_suball[0] if ch3_to_suball else None

    return {
        "center_idx": methyl_meta["center_idx"],
        "H_indices": list(methyl_meta["H_indices"]),
        "anchor_idx": methyl_meta["anchor_idx"],
        "anchor_element": methyl_meta["anchor_element"],
        "CH3_to_subheavy_summary": sh_summary,
        "CH3_to_suball_summary": sa_summary,
        "CH3_to_subheavy_contacts": ch3_to_subheavy,
        "CH3_to_suball_contacts": ch3_to_suball,
        "methylC_to_forming_C1_A": distance(mC, c1),
        "methylC_to_forming_C2_A": distance(mC, c2),
        "methylC_to_forming_CC_midpoint_A": point_distance(atom_point(mC), rxn_mid),
        "methylC_to_subheavy_centroid_A": point_distance(atom_point(mC), subheavy_centroid),
        "methylC_to_phenyl_centroid_A": point_distance(atom_point(mC), phenyl_centroid),
        "methylC_abs_distance_to_phenyl_plane_A": point_abs_distance_to_plane(atom_point(mC), phenyl_centroid, phenyl_normal),
        "CH3_to_phenylC_summary": phenyl_summary,
        "CH3_to_phenylC_contacts": ch3_to_phenylC,
        "closest_substrate_atom": closest["sub_idx"] if closest else "",
        "closest_substrate_element": closest["sub_element"] if closest else "",
        "closest_methyl_atom": closest["partner_idx"] if closest else "",
        "closest_distance_A": closest["distance_A"] if closest else float("nan"),
        "closest_vdw_gap_A": closest["vdw_gap_A"] if closest else float("nan"),
    }


def methyl_pair_descriptors(atoms, methyl_results, forming_info, phenyl_ring_indices):
    """
    Describe substrate placement relative to the axis connecting the two named
    methyl carbons.

    For METHYL_PAIR_ORDER = (quinoline_Me, pyridine_Me), positive signed
    shift points toward pyridine_Me.  Phenyl-ring centroid placement is the
    preferred conformational descriptor; forming-C midpoint values are retained
    only as complementary reaction-coordinate descriptors.
    """
    label_a, label_b = METHYL_PAIR_ORDER
    if label_a not in methyl_results or label_b not in methyl_results:
        return {}

    ad = atom_dict(atoms)
    ma = ad[methyl_results[label_a]["center_idx"]]
    mb = ad[methyl_results[label_b]["center_idx"]]
    c1 = ad[forming_info["mapped_C1"]]
    c2 = ad[forming_info["mapped_C2"]]

    pa = atom_point(ma)
    pb = atom_point(mb)
    mmid = (
        0.5 * (pa[0] + pb[0]),
        0.5 * (pa[1] + pb[1]),
        0.5 * (pa[2] + pb[2]),
    )
    rxn_mid = midpoint_atoms(c1, c2)
    sub_cent = centroid_from_atoms(heavy_substrate(atoms))
    phenyl_cent, phenyl_normal = ring_centroid_and_normal(atoms, phenyl_ring_indices)

    axis = (pb[0] - pa[0], pb[1] - pa[1], pb[2] - pa[2])
    axis_len = _norm(axis)
    if axis_len < 1e-12:
        return {}
    u = _scale(axis, 1.0 / axis_len)

    def decompose(point):
        rel = (point[0] - mmid[0], point[1] - mmid[1], point[2] - mmid[2])
        signed = _dot(rel, u)
        perp_vec = _sub(rel, _scale(u, signed))
        return signed, _norm(perp_vec)

    rxn_signed, rxn_perp = decompose(rxn_mid)
    sub_signed, sub_perp = decompose(sub_cent)
    phenyl_signed, phenyl_perp = decompose(phenyl_cent)

    d_a_rxn = point_distance(pa, rxn_mid)
    d_b_rxn = point_distance(pb, rxn_mid)
    d_a_ph = point_distance(pa, phenyl_cent)
    d_b_ph = point_distance(pb, phenyl_cent)

    return {
        "methyl_pair_label_A": label_a,
        "methyl_pair_label_B": label_b,
        "methylC_pair_distance_A": axis_len,
        "rxn_midpoint_distance_to_A_A": d_a_rxn,
        "rxn_midpoint_distance_to_B_A": d_b_rxn,
        "rxn_midpoint_distance_bias_AminusB_A": d_a_rxn - d_b_rxn,
        "rxn_midpoint_signed_shift_A_to_B_A": rxn_signed,
        "rxn_midpoint_perp_distance_to_methyl_axis_A": rxn_perp,
        "phenyl_centroid_distance_to_A_A": d_a_ph,
        "phenyl_centroid_distance_to_B_A": d_b_ph,
        "phenyl_centroid_distance_bias_AminusB_A": d_a_ph - d_b_ph,
        "phenyl_centroid_signed_shift_A_to_B_A": phenyl_signed,
        "phenyl_centroid_perp_distance_to_methyl_axis_A": phenyl_perp,
        "methyl_axis_angle_to_phenyl_plane_deg": angle_axis_to_plane_deg(axis, phenyl_normal),
        "substrate_heavy_centroid_signed_shift_A_to_B_A": sub_signed,
        "substrate_heavy_centroid_perp_distance_to_methyl_axis_A": sub_perp,
    }


def write_methyl_candidates(ref_atoms, resolved, candidates):
    label_by_center = {v["center_idx"]: k for k, v in resolved.items()}
    fields = [
        "methyl_carbon", "attached_H_atoms", "anchor_atom", "anchor_element",
        "configured_label", "note",
