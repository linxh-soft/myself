def read_xyz(filename):
    with open(filename, encoding="utf-8") as f:
        lines = f.readlines()
    nat = int(lines[0].strip())
    atoms = []
    for i, line in enumerate(lines[2:2 + nat], start=1):
        p = line.split()
        if len(p) < 4:
            raise ValueError(f"Malformed XYZ line in {filename}: {line.rstrip()}")
        atoms.append({
            "index": i,
            "element": p[0],
            "x": float(p[1]),
            "y": float(p[2]),
            "z": float(p[3]),
        })
    return atoms


def atom_dict(atoms):
    return {a["index"]: a for a in atoms}


def distance(a, b):
    return math.sqrt(
        (a["x"] - b["x"]) ** 2 +
        (a["y"] - b["y"]) ** 2 +
        (a["z"] - b["z"]) ** 2
    )


def bond_cutoff(e1, e2):
    return BOND_SCALE * (COV[e1] + COV[e2])


def vdw_gap(a, b):
    """d - (r_vdW,a + r_vdW,b). Negative = geometric vdW overlap."""
    return distance(a, b) - VDW[a["element"]] - VDW[b["element"]]


def overlap_depth_from_gap(gap):
    """Positive overlap depth in Å; 0 if gap >= 0."""
    return max(0.0, -gap)


# ----------------------------
# vector / torsion helpers
# ----------------------------

def _vec(a, b):
    return (b["x"] - a["x"], b["y"] - a["y"], b["z"] - a["z"])


def _dot(u, v):
    return u[0] * v[0] + u[1] * v[1] + u[2] * v[2]


def _cross(u, v):
    return (
        u[1] * v[2] - u[2] * v[1],
        u[2] * v[0] - u[0] * v[2],
        u[0] * v[1] - u[1] * v[0],
    )


def _norm(v):
    return math.sqrt(_dot(v, v))


def _scale(v, s):
    return (v[0] * s, v[1] * s, v[2] * s)


def _sub(u, v):
    return (u[0] - v[0], u[1] - v[1], u[2] - v[2])


def dihedral_deg(a, b, c, d):
    """Signed A-B-C-D dihedral in (-180, 180]."""
    b0 = _vec(b, a)
    b1 = _vec(b, c)
    b2 = _vec(c, d)

    n1 = _norm(b1)
    if n1 < 1e-12:
        return float("nan")
    b1u = _scale(b1, 1.0 / n1)

    v = _sub(b0, _scale(b1u, _dot(b0, b1u)))
    w = _sub(b2, _scale(b1u, _dot(b2, b1u)))
    if _norm(v) < 1e-12 or _norm(w) < 1e-12:
        return float("nan")

    x = _dot(v, w)
    y = _dot(_cross(b1u, v), w)
    phi = math.degrees(math.atan2(y, x))
    if phi <= -180.0 + 1e-12:
        phi = 180.0
    return phi



# ============================================================
# V12: TRUE COORDINATE RMSD (PURE PYTHON) + PHENYL/LIGAND BURIED SASA
# ============================================================

def _centroid_points(points):
    n = len(points)
    if n == 0:
        raise ValueError("Cannot compute centroid of zero points")
    return (
        sum(p[0] for p in points) / n,
        sum(p[1] for p in points) / n,
        sum(p[2] for p in points) / n,
    )


def _matvec3(m, v):
    return (
        m[0][0]*v[0] + m[0][1]*v[1] + m[0][2]*v[2],
        m[1][0]*v[0] + m[1][1]*v[1] + m[1][2]*v[2],
        m[2][0]*v[0] + m[2][1]*v[1] + m[2][2]*v[2],
    )


def _largest_eigenvector_symmetric_4x4(mat, niter=200, tol=1e-14):
    """Power iteration for the largest eigenvector of a symmetric 4x4 matrix."""
    q = [1.0, 0.0, 0.0, 0.0]
    for _ in range(niter):
        z = [sum(mat[i][j] * q[j] for j in range(4)) for i in range(4)]
        norm = math.sqrt(sum(x*x for x in z))
        if norm < 1e-30:
            return (1.0, 0.0, 0.0, 0.0)
        z = [x / norm for x in z]
        # q and -q are the same quaternion, so compare both signs.
        d1 = math.sqrt(sum((z[i] - q[i])**2 for i in range(4)))
        d2 = math.sqrt(sum((z[i] + q[i])**2 for i in range(4)))
        q = z
        if min(d1, d2) < tol:
            break
    return tuple(q)


def _quaternion_rotation_target_to_ref(ref_centered, target_centered):
    """
    Horn/Davenport optimal rotation mapping TARGET centered coordinates onto REF.
    No numpy dependency is used.
    """
    # Cross-dispersion matrix M = sum(target * ref^T)
    sxx = sxy = sxz = syx = syy = syz = szx = szy = szz = 0.0
    for p, q in zip(ref_centered, target_centered):
        # q = target, p = reference
        sxx += q[0]*p[0]; sxy += q[0]*p[1]; sxz += q[0]*p[2]
        syx += q[1]*p[0]; syy += q[1]*p[1]; syz += q[1]*p[2]
        szx += q[2]*p[0]; szy += q[2]*p[1]; szz += q[2]*p[2]

    tr = sxx + syy + szz
    nmat = [
        [tr,        syz-szy,   szx-sxz,   sxy-syx],
        [syz-szy,   sxx-syy-szz, sxy+syx, szx+sxz],
        [szx-sxz,   sxy+syx,  -sxx+syy-szz, syz+szy],
        [sxy-syx,   szx+sxz,   syz+szy,  -sxx-syy+szz],
    ]
    w, x, y, z = _largest_eigenvector_symmetric_4x4(nmat)

    # Quaternion -> rotation matrix.
    return (
        (1-2*(y*y+z*z), 2*(x*y-z*w),   2*(x*z+y*w)),
        (2*(x*y+z*w),   1-2*(x*x+z*z), 2*(y*z-x*w)),
        (2*(x*z-y*w),   2*(y*z+x*w),   1-2*(x*x+y*y)),
    )


def optimal_rigid_fit(ref_points, target_points):
    """
    Return (rotation, target_centroid, ref_centroid, rmsd) for the least-squares
    rigid fit TARGET -> REF.  Atom correspondence must already be established.
    """
    if len(ref_points) != len(target_points) or not ref_points:
        raise ValueError("RMSD point sets must be nonempty and have equal length")

    cref = _centroid_points(ref_points)
    ctar = _centroid_points(target_points)
    pr = [_sub(p, cref) for p in ref_points]
    pt = [_sub(p, ctar) for p in target_points]
    rot = _quaternion_rotation_target_to_ref(pr, pt)

    ss = 0.0
    for p, q in zip(pr, pt):
        qr = _matvec3(rot, q)
        ss += (qr[0]-p[0])**2 + (qr[1]-p[1])**2 + (qr[2]-p[2])**2
    rmsd = math.sqrt(ss / len(pr))
    return rot, ctar, cref, rmsd


def apply_rigid_fit_to_point(point, fit):
    rot, ctar, cref, _ = fit
    q = _sub(point, ctar)
    qr = _matvec3(rot, q)
    return (qr[0]+cref[0], qr[1]+cref[1], qr[2]+cref[2])


def rmsd_without_refit(ref_points, target_points_transformed):
    if len(ref_points) != len(target_points_transformed) or not ref_points:
        return float("nan")
    ss = 0.0
    for p, q in zip(ref_points, target_points_transformed):
        ss += (p[0]-q[0])**2 + (p[1]-q[1])**2 + (p[2]-q[2])**2
    return math.sqrt(ss / len(ref_points))


def fragment_rmsd_descriptors(ref_atoms, target_atoms, substrate_mapping,
                              ligand_mapping, phenyl_ring_ref):
    """
    True coordinate RMSDs relative to REFERENCE.

    Independent fragment RMSDs remove overall translation/rotation of each fragment.
    The substrate/phenyl POSE RMSDs instead fit Fe+ligand heavy atoms first, then
    measure the mapped substrate without a second fit.
    """
    rad = atom_dict(ref_atoms)
    tad = atom_dict(target_atoms)

    ref_lig_heavy = sorted(a["index"] for a in heavy_ligand(ref_atoms))
    ref_cat_core_ids = [FE_INDEX] + ref_lig_heavy
    tar_cat_core_ids = [FE_INDEX] + [ligand_mapping[i] for i in ref_lig_heavy]

    ref_cat_core_pts = [atom_point(rad[i]) for i in ref_cat_core_ids]
    tar_cat_core_pts = [atom_point(tad[i]) for i in tar_cat_core_ids]
    cat_core_fit = optimal_rigid_fit(ref_cat_core_pts, tar_cat_core_pts)

    # Include reactive O atoms as part of the catalyst fragment, using their fixed
    # atom identities.  Keep the Fe+ligand-only RMSD as a separate diagnostic.
    ref_cat_o_ids = ref_cat_core_ids + list(REACTIVE_O)
    tar_cat_o_ids = tar_cat_core_ids + list(REACTIVE_O)
    ref_cat_o_pts = [atom_point(rad[i]) for i in ref_cat_o_ids]
    tar_cat_o_pts = [atom_point(tad[i]) for i in tar_cat_o_ids]
    cat_o_fit = optimal_rigid_fit(ref_cat_o_pts, tar_cat_o_pts)

    ref_sub_ids = sorted(substrate_mapping.keys())
    tar_sub_ids = [substrate_mapping[i] for i in ref_sub_ids]
    ref_sub_pts = [atom_point(rad[i]) for i in ref_sub_ids]
    tar_sub_pts = [atom_point(tad[i]) for i in tar_sub_ids]
    sub_fit = optimal_rigid_fit(ref_sub_pts, tar_sub_pts)

    tar_sub_after_cat = [apply_rigid_fit_to_point(atom_point(tad[i]), cat_core_fit)
                         for i in tar_sub_ids]
    sub_pose_rmsd = rmsd_without_refit(ref_sub_pts, tar_sub_after_cat)

    ref_ph_ids = list(phenyl_ring_ref)
    tar_ph_ids = [substrate_mapping[i] for i in ref_ph_ids]
    ref_ph_pts = [atom_point(rad[i]) for i in ref_ph_ids]
    tar_ph_after_cat = [apply_rigid_fit_to_point(atom_point(tad[i]), cat_core_fit)
                        for i in tar_ph_ids]
    ph_pose_rmsd = rmsd_without_refit(ref_ph_pts, tar_ph_after_cat)

    return {
        "cat_FeLig_heavy_internal_RMSD_A": cat_core_fit[3],
        "cat_FeLigO_heavy_internal_RMSD_A": cat_o_fit[3],
        "substrate_heavy_internal_RMSD_A": sub_fit[3],
        "substrate_heavy_pose_RMSD_after_FeLig_alignment_A": sub_pose_rmsd,
        "phenyl_ring_pose_RMSD_after_FeLig_alignment_A": ph_pose_rmsd,
    }



def resolve_deformation_core_ref(ref_atoms):
    """
    Return reference atom indices used for catalyst-core alignment.

    Default: Fe + four nearest ligand N atoms.  This is intentionally independent
    of the generic covalent-radius graph, because Fe is not part of that graph.
    """
    ad = atom_dict(ref_atoms)
    if DEFORMATION_CORE_REF is not None:
        ids = list(DEFORMATION_CORE_REF)
        missing = [i for i in ids if i not in ad]
        if missing:
            raise RuntimeError(f"DEFORMATION_CORE_REF contains missing atoms: {missing}")
        if FE_INDEX not in ids:
            raise RuntimeError("DEFORMATION_CORE_REF must include FE_INDEX")
        return ids, "manual"

    fe = ad[FE_INDEX]
    ligand_n = [
        a for a in ref_atoms
        if LIG_START <= a["index"] <= LIG_END and a["element"] == "N"
    ]
    if len(ligand_n) < 4:
        raise RuntimeError(
            f"Auto Fe+N4 core detection found only {len(ligand_n)} ligand N atoms"
        )
    ligand_n.sort(key=lambda a: distance(fe, a))
    chosen = ligand_n[:4]
    return [FE_INDEX] + [a["index"] for a in chosen], "auto_Fe_plus_4_nearest_ligand_N"


def _rank_desc(values):
    """1-based descending ranks; ties are left in deterministic atom order."""
    order = sorted(range(len(values)), key=lambda i: (-values[i], i))
    ranks = [0] * len(values)
    for rank, i in enumerate(order, start=1):
        ranks[i] = rank
    return ranks


def _displacement_rows_for_fit(ref_atoms, target_atoms, ref_ids, tar_ids, fit):
    """Return per-atom displacements after applying one precomputed rigid fit."""
    rad = atom_dict(ref_atoms)
    tad = atom_dict(target_atoms)
    rows = []
    for ri, ti in zip(ref_ids, tar_ids):
        rp = atom_point(rad[ri])
        tp = apply_rigid_fit_to_point(atom_point(tad[ti]), fit)
        d = point_distance(rp, tp)
        rows.append((ri, ti, rad[ri]["element"], d))
    return rows


def _build_generic_heavy_graph(atoms):
    """Build a covalent graph for all non-H atoms in an arbitrary standalone fragment."""
    heavy = [a for a in atoms if a["element"] != "H"]
    graph = {a["index"]: set() for a in heavy}
    adict = {a["index"]: a for a in heavy}
    for i in range(len(heavy)):
        for j in range(i + 1, len(heavy)):
            a, b = heavy[i], heavy[j]
            if a["element"] not in COV or b["element"] not in COV:
                raise RuntimeError(
                    f"Cannot infer standalone-fragment connectivity for element pair "
                    f"{a['element']}/{b['element']}; add covalent radii to COV if needed."
                )
            if distance(a, b) <= bond_cutoff(a["element"], b["element"]):
                graph[a["index"]].add(b["index"])
                graph[b["index"]].add(a["index"])
    return graph, adict


def _best_isolated_substrate_mapping(sub_ref_atoms, mapping_ref_atoms):
    """
    Map heavy atoms of an arbitrarily ordered isolated substrate XYZ onto the
    substrate heavy atoms of the mapping-reference TS.

    Connectivity + element signatures generate chemically valid graph maps.
    If symmetry gives several maps, choose the one with the smallest Kabsch RMSD
    between isolated-substrate and mapping-reference substrate heavy atoms.

    Returns
    -------
    local_sub_to_mapref : dict
        isolated-substrate local atom index -> mapping-reference TS atom index
        for HEAVY atoms only.
    best_rmsd : float
    n_mappings : int
    """
    ref_sub_heavy = [a for a in substrate_atoms(mapping_ref_atoms) if a["element"] != "H"]
    if len([a for a in sub_ref_atoms if a["element"] != "H"]) != len(ref_sub_heavy):
        raise RuntimeError(
            f"Substrate reference {SUB_REFERENCE_XYZ!r} has "
            f"{len([a for a in sub_ref_atoms if a['element'] != 'H'])} heavy atoms; "
            f"mapping-reference TS has {len(ref_sub_heavy)} substrate heavy atoms."
        )

    sg, sa = _build_generic_heavy_graph(sub_ref_atoms)

    # Build the same kind of graph, but only on the mapping-reference substrate heavy atoms.
    tg = {a["index"]: set() for a in ref_sub_heavy}
    ta = {a["index"]: a for a in ref_sub_heavy}
    for i in range(len(ref_sub_heavy)):
        for j in range(i + 1, len(ref_sub_heavy)):
            a, b = ref_sub_heavy[i], ref_sub_heavy[j]
            if distance(a, b) <= bond_cutoff(a["element"], b["element"]):
                tg[a["index"]].add(b["index"])
                tg[b["index"]].add(a["index"])

    maps = find_mappings(sg, sa, tg, ta)
    if not maps:
        raise RuntimeError(
            "Could not graph-map the isolated substrate onto the mapping-reference TS. "
            "Check that sub.xyz has the same molecular connectivity/protonation as the TS substrate."
        )

    best = None
    for m in maps:
        local_ids = sorted(m)
        tar_ids = [m[i] for i in local_ids]
        fit = optimal_rigid_fit(
            [atom_point(sa[i]) for i in local_ids],
            [atom_point(ta[j]) for j in tar_ids],
        )
        score = fit[3]
        # deterministic tie-break by mapped atom tuple
        key = (score, tuple(tar_ids))
        if best is None or key < best[0]:
            best = (key, dict(m))

    return best[1], best[0][0], len(maps)


def _write_isolated_substrate_mapping(local_sub_to_mapref, sub_ref_atoms, mapping_ref_atoms,
                                       best_rmsd, n_mappings):
    sad = atom_dict(sub_ref_atoms)
    rad = atom_dict(mapping_ref_atoms)
    fields = [
        "isolated_sub_atom", "isolated_sub_element",
        "mapping_reference_TS_atom", "mapping_reference_TS_element",
        "selected_mapping_Kabsch_RMSD_A", "n_valid_graph_mappings",
    ]
    with open("isolated_substrate_mapping_v12_5.csv", "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=fields)
        w.writeheader()
        for local_i in sorted(local_sub_to_mapref):
            ref_i = local_sub_to_mapref[local_i]
            w.writerow({
                "isolated_sub_atom": local_i,
                "isolated_sub_element": sad[local_i]["element"],
                "mapping_reference_TS_atom": ref_i,
                "mapping_reference_TS_element": rad[ref_i]["element"],
                "selected_mapping_Kabsch_RMSD_A": fmt(best_rmsd),
                "n_valid_graph_mappings": n_mappings,
            })


def _validate_isolated_fragment_order(cat_ref_atoms, sub_ref_atoms, mapping_ref_atoms):
    """
    Validate isolated references.

    Catalyst: still requires the same atom order as TS atoms 1..SUB_START-1,
              because Fe/ligand/reactive-O correspondence is chemically specific.
    Substrate: atom order is NOT required to match.  V12.5 graph-maps the
               isolated substrate heavy atoms automatically.
    """
    expected_cat_n = SUB_START - 1
    if len(cat_ref_atoms) != expected_cat_n:
        raise RuntimeError(
            f"Catalyst reference {CAT_REFERENCE_XYZ!r} has {len(cat_ref_atoms)} atoms; "
            f"expected exactly {expected_cat_n} atoms (TS atoms 1..{expected_cat_n})."
        )

    rad = atom_dict(mapping_ref_atoms)
    cad = atom_dict(cat_ref_atoms)
    for i in range(1, expected_cat_n + 1):
        if cad[i]["element"] != rad[i]["element"]:
            raise RuntimeError(
                f"Catalyst reference atom-order mismatch at local atom {i}: "
                f"cat ref has {cad[i]['element']}, mapping reference TS has {rad[i]['element']}. "
                "For V12.5, cat.xyz still needs the same atom order as the catalyst fragment "
                "in the reordered TS files.  sub.xyz no longer has this restriction."
            )

    ref_sub = substrate_atoms(mapping_ref_atoms)
    if len(sub_ref_atoms) != len(ref_sub):
        raise RuntimeError(
            f"Substrate reference {SUB_REFERENCE_XYZ!r} has {len(sub_ref_atoms)} total atoms; "
            f"mapping-reference TS has {len(ref_sub)} substrate atoms. "
            "Atom ORDER may differ, but the molecular composition must match."
        )

    ref_counts = {}
    sub_counts = {}
    for a in ref_sub:
        ref_counts[a["element"]] = ref_counts.get(a["element"], 0) + 1
    for a in sub_ref_atoms:
        sub_counts[a["element"]] = sub_counts.get(a["element"], 0) + 1
    if ref_counts != sub_counts:
        raise RuntimeError(
            f"Substrate elemental composition mismatch: isolated sub {sub_counts}, "
            f"mapping-reference TS substrate {ref_counts}."
        )


def _target_cat_index_from_ref_index(ref_idx, ligand_mapping):
    if ref_idx == FE_INDEX or ref_idx in REACTIVE_O:
        return ref_idx
    if LIG_START <= ref_idx <= LIG_END:
        return ligand_mapping[ref_idx]
    raise RuntimeError(f"Unsupported catalyst reference atom index {ref_idx}")


def isolated_fragment_deformation(structures, substrate_mappings, ligand_mappings,
                                  mapping_ref_atoms, cat_ref_atoms, sub_ref_atoms):
    """
    Compare every selected TS independently against isolated caT.XYZ / sub.xyz.

    This is the atom-resolved analysis intended to accompany preparation energies.
    NO TS is used as the deformation reference.

    Catalyst:
      * heavy-atom best-fit RMSD vs isolated catalyst
      * per-atom d^2 contribution to that RMSD^2
      * per-atom displacement after isolated-catalyst Fe+N4 core alignment

    Substrate:
      * heavy-atom best-fit RMSD vs isolated substrate
      * per-atom d^2 contribution to that RMSD^2

    Returns
    -------
    metrics_by_structure, core_ref_ids, core_mode
    """
    _validate_isolated_fragment_order(cat_ref_atoms, sub_ref_atoms, mapping_ref_atoms)

    cad = atom_dict(cat_ref_atoms)
    sad = atom_dict(sub_ref_atoms)
    maprad = atom_dict(mapping_ref_atoms)

    # Heavy atoms of the isolated catalyst correspond to the same local indices
    # as atoms 1..64 in the mapping-reference TS.
    cat_heavy_ref_ids = [a["index"] for a in cat_ref_atoms if a["element"] != "H"]
    core_ref_ids, core_mode = resolve_deformation_core_ref(cat_ref_atoms)
    core_set = set(core_ref_ids)

    # V12.5: isolated substrate atom order may be arbitrary.
    # Establish heavy-atom correspondence by graph mapping, then use the existing
    # mapping-reference -> target-TS substrate maps for every selected structure.
    local_sub_to_mapref, isolated_sub_map_rmsd, isolated_sub_nmaps = \
        _best_isolated_substrate_mapping(sub_ref_atoms, mapping_ref_atoms)
    _write_isolated_substrate_mapping(
        local_sub_to_mapref, sub_ref_atoms, mapping_ref_atoms,
        isolated_sub_map_rmsd, isolated_sub_nmaps,
    )
    sub_heavy_local_ids = sorted(local_sub_to_mapref)

    cat_rows_all = []
    sub_rows_all = []
    metrics = {}

    for name, atoms in structures.items():
        tad = atom_dict(atoms)
        ligmap = ligand_mappings[name]
        submap = substrate_mappings[name]

        # ---------------- catalyst vs isolated cat ----------------
        cat_tar_ids = [
            _target_cat_index_from_ref_index(i, ligmap) for i in cat_heavy_ref_ids
        ]
        # Validate element identity after mapping.
        for ri, ti in zip(cat_heavy_ref_ids, cat_tar_ids):
            if cad[ri]["element"] != tad[ti]["element"]:
                raise RuntimeError(
                    f"{name}: catalyst mapping element mismatch cat-ref {cad[ri]['element']}{ri} "
                    f"-> TS {tad[ti]['element']}{ti}"
                )

        cat_fit = optimal_rigid_fit(
            [atom_point(cad[i]) for i in cat_heavy_ref_ids],
            [atom_point(tad[i]) for i in cat_tar_ids],
        )
        cat_disp = _displacement_rows_for_fit(
            cat_ref_atoms, atoms, cat_heavy_ref_ids, cat_tar_ids, cat_fit
        )
        cat_d2 = [x[3] ** 2 for x in cat_disp]
        cat_sumd2 = sum(cat_d2)
        cat_ranks = _rank_desc([x[3] for x in cat_disp])

        core_tar_ids = [
            _target_cat_index_from_ref_index(i, ligmap) for i in core_ref_ids
        ]
        core_fit = optimal_rigid_fit(
            [atom_point(cad[i]) for i in core_ref_ids],
            [atom_point(tad[i]) for i in core_tar_ids],
        )
        cat_core_disp = _displacement_rows_for_fit(
            cat_ref_atoms, atoms, cat_heavy_ref_ids, cat_tar_ids, core_fit
        )
        core_ranks = _rank_desc([x[3] for x in cat_core_disp])

        for j, ((ri, ti, el, dall), (_, _, _, dcore)) in enumerate(
            zip(cat_disp, cat_core_disp)
        ):
            if ri == FE_INDEX:
                region = "Fe"
            elif ri in REACTIVE_O:
                region = "reactive_O"
            else:
                region = "ligand_heavy"
            cat_rows_all.append({
                "structure": name,
                "mechanism": mechanism_label(name),
                "stereo": stereo_label(name),
                "isolated_reference": CAT_REFERENCE_XYZ,
                "reference_atom": ri,
                "mapped_TS_atom": ti,
                "element": el,
                "region": region,
                "is_FeN4_alignment_core": int(ri in core_set),
                "FeN4_core_mode": core_mode,
                "FeN4_core_reference_atoms": ";".join(map(str, core_ref_ids)),
                "displacement_after_isolated_cat_allheavy_fit_A": dall,
                "contribution_to_isolated_cat_RMSD2_pct": (
                    100.0 * cat_d2[j] / cat_sumd2 if cat_sumd2 > 1e-30 else 0.0
                ),
                "rank_by_isolated_cat_allheavy_displacement": cat_ranks[j],
                "displacement_after_isolated_cat_FeN4_core_fit_A": dcore,
                "rank_by_isolated_cat_FeN4_core_displacement": core_ranks[j],
            })

        # ---------------- substrate vs isolated sub ----------------
        sub_tar_ids = []
        for local_i in sub_heavy_local_ids:
            map_ref_idx = local_sub_to_mapref[local_i]
            if map_ref_idx not in submap:
                raise RuntimeError(
                    f"{name}: mapping-reference substrate atom {map_ref_idx} missing from substrate mapping"
                )
            sub_tar_ids.append(submap[map_ref_idx])
        for ri, ti in zip(sub_heavy_local_ids, sub_tar_ids):
            if sad[ri]["element"] != tad[ti]["element"]:
                raise RuntimeError(
                    f"{name}: substrate mapping element mismatch sub-ref {sad[ri]['element']}{ri} "
                    f"-> TS {tad[ti]['element']}{ti}"
                )

        sub_fit = optimal_rigid_fit(
            [atom_point(sad[i]) for i in sub_heavy_local_ids],
            [atom_point(tad[i]) for i in sub_tar_ids],
        )
        sub_disp = _displacement_rows_for_fit(
            sub_ref_atoms, atoms, sub_heavy_local_ids, sub_tar_ids, sub_fit
        )
        sub_d2 = [x[3] ** 2 for x in sub_disp]
        sub_sumd2 = sum(sub_d2)
        sub_ranks = _rank_desc([x[3] for x in sub_disp])

        for j, (ri, ti, el, dint) in enumerate(sub_disp):
            sub_rows_all.append({
                "structure": name,
                "mechanism": mechanism_label(name),
                "stereo": stereo_label(name),
                "isolated_reference": SUB_REFERENCE_XYZ,
                "reference_atom": ri,
                "mapping_reference_TS_atom": local_sub_to_mapref[ri],
                "mapped_TS_atom": ti,
                "element": el,
                "internal_displacement_vs_isolated_sub_A": dint,
                "contribution_to_isolated_sub_RMSD2_pct": (
                    100.0 * sub_d2[j] / sub_sumd2 if sub_sumd2 > 1e-30 else 0.0
                ),
                "rank_by_isolated_sub_displacement": sub_ranks[j],
            })

        metrics[name] = {
            "cat_isolated_ref_heavy_RMSD_A": cat_fit[3],
            "sub_isolated_ref_heavy_RMSD_A": sub_fit[3],
            "cat_isolated_ref_FeN4_core_fit_RMSD_A": core_fit[3],
            "isolated_sub_to_mapping_ref_Kabsch_RMSD_A": isolated_sub_map_rmsd,
            "isolated_sub_n_valid_graph_mappings": isolated_sub_nmaps,
        }

    def write_rows(path, rows):
        fields = []
        seen = set()
        for row in rows:
            for k in row:
                if k not in seen:
                    seen.add(k)
                    fields.append(k)
        with open(path, "w", newline="", encoding="utf-8") as f:
            w = csv.DictWriter(f, fieldnames=fields)
            w.writeheader()
            for row in rows:
                w.writerow({k: fmt(row.get(k, "")) for k in fields})

    write_rows(CAT_ATOM_DISP_OUT, cat_rows_all)
    write_rows(SUB_ATOM_DISP_OUT, sub_rows_all)
    return metrics, core_ref_ids, core_mode


def _fibonacci_sphere_points(n):
    """Approximately uniform unit-sphere points, deterministic."""
    pts = []
    golden = math.pi * (3.0 - math.sqrt(5.0))
    for i in range(n):
        y = 1.0 - 2.0 * (i + 0.5) / n
        r = math.sqrt(max(0.0, 1.0 - y*y))
        phi = golden * i
        pts.append((math.cos(phi)*r, y, math.sin(phi)*r))
    return pts


_SASA_UNIT_POINTS = None


def _sasa_unit_points():
    global _SASA_UNIT_POINTS
    if _SASA_UNIT_POINTS is None or len(_SASA_UNIT_POINTS) != SASA_N_POINTS:
        _SASA_UNIT_POINTS = _fibonacci_sphere_points(SASA_N_POINTS)
    return _SASA_UNIT_POINTS


def sasa_of_group(atoms, group_indices, environment_indices):
    """
    Approximate SASA (A^2) of group_indices in the specified environment.
    Radii = empirical vdW radius + SASA_PROBE_A.
    """
    ad = atom_dict(atoms)
    group_indices = list(dict.fromkeys(group_indices))
    environment_indices = list(dict.fromkeys(environment_indices))
    unit_pts = _sasa_unit_points()
    total = 0.0

    for i in group_indices:
        ai = ad[i]
        ri = VDW[ai["element"]] + SASA_PROBE_A
        # Only atoms whose expanded spheres can geometrically occlude this atom.
        occluders = []
        for j in environment_indices:
            if j == i:
                continue
            aj = ad[j]
            rj = VDW[aj["element"]] + SASA_PROBE_A
            dij = distance(ai, aj)
            if dij < ri + rj:
                occluders.append((aj, rj*rj))

        accessible = 0
        for u in unit_pts:
            p = (ai["x"] + ri*u[0], ai["y"] + ri*u[1], ai["z"] + ri*u[2])
            blocked = False
            for aj, rj2 in occluders:
                dx = p[0] - aj["x"]
                dy = p[1] - aj["y"]
                dz = p[2] - aj["z"]
                if dx*dx + dy*dy + dz*dz < rj2:
                    blocked = True
                    break
            if not blocked:
                accessible += 1
        total += (accessible / SASA_N_POINTS) * (4.0 * math.pi * ri * ri)
    return total


def phenyl_group_indices_with_H(atoms, phenyl_ring_indices):
    ids = list(phenyl_ring_indices)
    if PHENYL_CONTACT_INCLUDE_ATTACHED_H:
        hparents = assign_hydrogens(atoms)
        for ci in phenyl_ring_indices:
            ids.extend(hparents.get(ci, []))
    return sorted(set(ids))


def phenyl_ligand_contact_area_descriptors(atoms, phenyl_ring_indices):
    """
    Buried SASA between the substrate phenyl group and ligand atoms 2-62 only.
    Other substrate atoms, Fe, and reactive O atoms are intentionally excluded from
    the mutual-interface calculation.

    BSA_total = buried area on phenyl side + buried area on ligand side.
    interface_area_halfBSA = 0.5 * BSA_total (common single-interface convention).
    """
    phenyl_ids = phenyl_group_indices_with_H(atoms, phenyl_ring_indices)
    lig_ids = [a["index"] for a in ligand_atoms(atoms)]
    combined = phenyl_ids + lig_ids

    sasa_ph_alone = sasa_of_group(atoms, phenyl_ids, phenyl_ids)
    sasa_ph_with_lig = sasa_of_group(atoms, phenyl_ids, combined)
    sasa_lig_alone = sasa_of_group(atoms, lig_ids, lig_ids)
    sasa_lig_with_ph = sasa_of_group(atoms, lig_ids, combined)

    buried_ph = max(0.0, sasa_ph_alone - sasa_ph_with_lig)
    buried_lig = max(0.0, sasa_lig_alone - sasa_lig_with_ph)
    bsa_total = buried_ph + buried_lig

    # Existing contact machinery, restricted to phenyl-group atoms vs ligand.
    contacts = build_contact_list(atoms, phenyl_ids, ligand_atoms(atoms))
    cs = summarize_contacts(contacts)

    return {
        "phenyl_contact_group_atoms": ";".join(map(str, phenyl_ids)),
        "phenyl_contact_group_n_atoms": len(phenyl_ids),
        "phenyl_ligand_min_distance_A": cs["min_distance_A"],
        "phenyl_ligand_min_vdw_gap_A": cs["min_vdw_gap_A"],
        "phenyl_ligand_vdw_overlap_sum_A": cs["vdw_overlap_sum_A"],
        "phenyl_ligand_phenyl_buried_SASA_A2": buried_ph,
        "phenyl_ligand_ligand_buried_SASA_A2": buried_lig,
        "phenyl_ligand_BSA_total_A2": bsa_total,
        "phenyl_ligand_interface_area_halfBSA_A2": 0.5 * bsa_total,
    }

# ============================================================
# SUBSTRATE GRAPH MAPPING
# ============================================================

def substrate_atoms(atoms):
    return [a for a in atoms if a["index"] >= SUB_START]


def heavy_substrate(atoms):
    return [a for a in substrate_atoms(atoms) if a["element"] != "H"]


def build_graph(atoms):
    heavy = heavy_substrate(atoms)
    graph = {a["index"]: set() for a in heavy}
    adict = {a["index"]: a for a in heavy}

    for i in range(len(heavy)):
        for j in range(i + 1, len(heavy)):
            a, b = heavy[i], heavy[j]
            if distance(a, b) <= bond_cutoff(a["element"], b["element"]):
                graph[a["index"]].add(b["index"])
                graph[b["index"]].add(a["index"])
    return graph, adict


def signature(idx, graph, atoms):
    neigh_elements = sorted(atoms[n]["element"] for n in graph[idx])
    return (atoms[idx]["element"], len(graph[idx]), tuple(neigh_elements))


def find_mappings(ref_graph, ref_atoms, target_graph, target_atoms):
    candidates = {}
    for r in ref_graph:
        sr = signature(r, ref_graph, ref_atoms)
        candidates[r] = [
            t for t in target_graph
            if signature(t, target_graph, target_atoms) == sr
        ]
        if not candidates[r]:
            return []

    order = sorted(ref_graph, key=lambda r: (len(candidates[r]), -len(ref_graph[r])))
    solutions = []

    def backtrack(pos, mapping, used):
        if len(solutions) >= MAX_MAPPINGS:
            return
        if pos == len(order):
            solutions.append(mapping.copy())
            return

        r = order[pos]
        for t in candidates[r]:
            if t in used:
                continue
            ok = True
            for r2, t2 in mapping.items():
                if ((r2 in ref_graph[r]) != (t2 in target_graph[t])):
                    ok = False
                    break
            if not ok:
                continue
            mapping[r] = t
            used.add(t)
            backtrack(pos + 1, mapping, used)
            used.remove(t)
            del mapping[r]

    backtrack(0, {}, set())
    return solutions


def distance_matrix_rms(mapping, ref_atoms, target_atoms):
    """
    RMS difference between all mapped heavy-atom internal pair distances.
    This is NOT a coordinate/Kabsch RMSD.
    """
    indices = sorted(mapping)
    ss = 0.0
    n = 0
    for i in range(len(indices)):
        for j in range(i + 1, len(indices)):
            ri, rj = indices[i], indices[j]
            ti, tj = mapping[ri], mapping[rj]
            dr = distance(ref_atoms[ri], ref_atoms[rj])
            dt = distance(target_atoms[ti], target_atoms[tj])
            ss += (dr - dt) ** 2
            n += 1
    return math.sqrt(ss / n) if n else 0.0


def best_mapping(ref_atoms_all, target_atoms_all):
    rg, ra = build_graph(ref_atoms_all)
    tg, ta = build_graph(target_atoms_all)
    mappings = find_mappings(rg, ra, tg, ta)
    if not mappings:
        raise RuntimeError("No substrate graph mapping found")
    scored = [(distance_matrix_rms(m, ra, ta), m) for m in mappings]
    scored.sort(key=lambda x: x[0])
    return scored[0][1], scored[0][0], len(mappings)


def symmetry_groups(ref_atoms_all):
    graph, atoms = build_graph(ref_atoms_all)
    autos = find_mappings(graph, atoms, graph, atoms)
    parent = {i: i for i in graph}

    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[rb] = ra

    for m in autos:
        for i, j in m.items():
            union(i, j)

    groups = {}
    for i in graph:
        groups.setdefault(find(i), []).append(i)
    groups = [sorted(v) for v in groups.values()]
    groups.sort(key=lambda g: min(g))
    return groups, len(autos)


def assign_hydrogens(atoms):
    subs = substrate_atoms(atoms)
    heavy = [a for a in subs if a["element"] != "H"]
    hydrogens = [a for a in subs if a["element"] == "H"]
    result = {a["index"]: [] for a in heavy}

    for h in hydrogens:
        candidates = []
        for hv in heavy:
            d = distance(h, hv)
            if d <= bond_cutoff("H", hv["element"]):
                candidates.append((d, hv["index"]))
        if candidates:
            candidates.sort()
            result[candidates[0][1]].append(h["index"])
    return result


# ============================================================
# CONTACT ANALYSIS -- GEOMETRIC ONLY
# ============================================================

def ligand_atoms(atoms):
    # All ligand atoms, including ligand H atoms.
    return [a for a in atoms if LIG_START <= a["index"] <= LIG_END]


def reactive_oxygen_atoms(atoms):
    ad = atom_dict(atoms)
    return [ad[i] for i in REACTIVE_O]


def build_contact_list(atoms, substrate_indices, partner_atoms, skip_pairs=None):
    """
    Build raw geometric contacts.

    skip_pairs: exact (substrate_index, partner_index) pairs to omit.
    No energetic sign is assigned here.
    """
    if skip_pairs is None:
        skip_pairs = set()

    ad = atom_dict(atoms)
    contacts = []
    for si in substrate_indices:
        s = ad[si]
        for p in partner_atoms:
            if (si, p["index"]) in skip_pairs:
                continue
            d = distance(s, p)
            g = d - VDW[s["element"]] - VDW[p["element"]]
            contacts.append({
                "sub_idx": si,
                "sub_element": s["element"],
                "partner_idx": p["index"],
                "partner_element": p["element"],
                "distance_A": d,
                "vdw_gap_A": g,
                "vdw_overlap_depth_A": overlap_depth_from_gap(g),
                "is_vdw_overlap": int(g < 0.0),
                "is_proximity": int(g <= PROXIMITY_GAP_A),
            })

    contacts.sort(key=lambda x: x["vdw_gap_A"])
    return contacts


def summarize_contacts(contacts):
    if not contacts:
        return {
            "min_distance_A": float("nan"),
            "min_vdw_gap_A": float("nan"),
            "vdw_overlap_sum_A": 0.0,
            "n_vdw_overlap": 0,
            "n_proximity": 0,
            "n_pairs": 0,
        }

    return {
        "min_distance_A": min(c["distance_A"] for c in contacts),
        "min_vdw_gap_A": min(c["vdw_gap_A"] for c in contacts),
        "vdw_overlap_sum_A": sum(c["vdw_overlap_depth_A"] for c in contacts),
        "n_vdw_overlap": sum(c["is_vdw_overlap"] for c in contacts),
        "n_proximity": sum(c["is_proximity"] for c in contacts),
        "n_pairs": len(contacts),
    }


def contacts_for_sub_element(contacts, element):
    return [c for c in contacts if c["sub_element"] == element]


def contacts_for_other_elements(contacts, named=("H", "C", "N")):
    return [c for c in contacts if c["sub_element"] not in named]


def top_contacts_string(contacts, n=TOP_N):
    out = []
    for c in contacts[:n]:
        out.append(
            "%s%d-%s%d:g=%+.3f,d=%.3f" % (
                c["sub_element"], c["sub_idx"],
                c["partner_element"], c["partner_idx"],
                c["vdw_gap_A"], c["distance_A"]
            )
        )
    return "; ".join(out)


