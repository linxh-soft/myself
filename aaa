            aj = ad[j]
            rj = VDW[aj["element"]] + SASA_PROBE_A
            dij = distance(ai, aj)
            if dij < ri + rj:
                occluders.append((aj, rj*rj))
        accessible = 0
        for u in unit_pts:
            p = (ai["x"] + ri*u[0], ai["y"] + ri*u[1], ai["z"] + ri*u[2])
            blocked = False
            for aj, rj2 in occluders:
                dx = p[0]-aj["x"]; dy = p[1]-aj["y"]; dz = p[2]-aj["z"]
                if dx*dx + dy*dy + dz*dz < rj2:
                    blocked = True; break
            if not blocked:
                accessible += 1
        out[i] = (accessible / SASA_N_POINTS) * (4.0 * math.pi * ri * ri)
    return out


def write_bsa_atom_contributions(structures, mappings, phenyl_ring_ref):
    fields = [
        "structure", "side", "atom", "element", "buried_SASA_contribution_A2",
        "fraction_of_side_buried_SASA_pct", "rank_within_side",
    ]
    rows = []
    for name, atoms in structures.items():
        ad = atom_dict(atoms)
        phenyl_ring_indices = mapped_ring_indices(mappings[name], phenyl_ring_ref)
        phenyl_ids = phenyl_group_indices_with_H(atoms, phenyl_ring_indices)
        lig_ids = [a["index"] for a in ligand_atoms(atoms)]
        combined = phenyl_ids + lig_ids

        ph_alone = _sasa_per_atom(atoms, phenyl_ids, phenyl_ids)
        ph_with = _sasa_per_atom(atoms, phenyl_ids, combined)
        lig_alone = _sasa_per_atom(atoms, lig_ids, lig_ids)
        lig_with = _sasa_per_atom(atoms, lig_ids, combined)
        for side, ids, alone, with_other in (
            ("phenyl", phenyl_ids, ph_alone, ph_with),
            ("ligand", lig_ids, lig_alone, lig_with),
        ):
            vals = {i: max(0.0, alone[i]-with_other[i]) for i in ids}
            total = sum(vals.values())
            ranked = sorted(ids, key=lambda i: (-vals[i], i))
            rank = {i: n+1 for n, i in enumerate(ranked)}
            for i in ids:
                rows.append({
                    "structure": name, "side": side, "atom": i,
                    "element": ad[i]["element"],
                    "buried_SASA_contribution_A2": vals[i],
                    "fraction_of_side_buried_SASA_pct": (100.0*vals[i]/total if total > 1e-30 else 0.0),
                    "rank_within_side": rank[i],
                })
    with open(BSA_ATOM_CONTRIB_OUT, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=fields)
        w.writeheader()
        for r in rows:
            w.writerow({k: fmt(r.get(k, "")) for k in fields})
    return rows


def _top_contact_rows(path, selected_names, atom1, atom2, topn=REPORT_TOP_CONTACTS):
    rows = _read_csv_rows(path)
    out = {n: [] for n in selected_names}
    for n in selected_names:
        rr = [r for r in rows if r.get("structure") == n]
        rr.sort(key=lambda r: (-(_to_float(r.get("vdw_overlap_depth_A")) or 0.0),
                               (_to_float(r.get("distance_A")) or 999.0)))
        # Prefer actual overlap rows. If none, retain nearest contacts.
        pos = [r for r in rr if (_to_float(r.get("vdw_overlap_depth_A")) or 0.0) > 0]
        out[n] = (pos if pos else sorted(rr, key=lambda r: _to_float(r.get("distance_A")) or 999.0))[:topn]
    return out


def _pairwise_atom_deformation_deltas(cat_rows, sub_rows, a, b, topn=REPORT_TOP_ATOMS):
    def calc(rows, dfield, pctfield):
        aa = {int(r["reference_atom"]): r for r in rows if r.get("structure") == a}
        bb = {int(r["reference_atom"]): r for r in rows if r.get("structure") == b}
        vals = []
        for idx in sorted(set(aa) & set(bb)):
            da = _to_float(aa[idx].get(dfield)) or 0.0
            db = _to_float(bb[idx].get(dfield)) or 0.0
            vals.append((abs(da*da-db*db), idx, aa[idx].get("element", ""), da, db,
                         da*da-db*db,
                         _to_float(aa[idx].get(pctfield)), _to_float(bb[idx].get(pctfield))))
        vals.sort(reverse=True)
        return vals[:topn]
    return (
        calc(cat_rows, "displacement_after_isolated_cat_allheavy_fit_A", "contribution_to_isolated_cat_RMSD2_pct"),
        calc(sub_rows, "internal_displacement_vs_isolated_sub_A", "contribution_to_isolated_sub_RMSD2_pct"),
    )


def _fmt_num(x, nd=3):
    v = _numeric_or_none(x)
    return "NA" if v is None else f"{v:.{nd}f}"


