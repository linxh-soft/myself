def group_analysis(atoms, mapping, ref_groups, forming_info, include_sub_H=False):
    hparents = assign_hydrogens(atoms)
    lig = ligand_atoms(atoms)
    oxy = reactive_oxygen_atoms(atoms)
    ad = atom_dict(atoms)
    result = {}

    for gid, ref_group in enumerate(ref_groups, start=1):
        mapped_heavy = [mapping[r] for r in ref_group]
        indices = list(mapped_heavy)
        if include_sub_H:
            for hv in mapped_heavy:
                indices.extend(hparents.get(hv, []))

        lig_contacts = build_contact_list(atoms, indices, lig)
        secO_contacts = build_contact_list(
            atoms, indices, oxy,
            skip_pairs=forming_info["primary_pairs"]
        )

        raw_o_distances = [
            distance(ad[si], ad[oi])
            for si in indices
            for oi in REACTIVE_O
        ]

        result[gid] = {
            "ref_group": ref_group,
            "mapped_heavy": sorted(mapped_heavy),
            "sub_indices": sorted(indices),
            "lig_contacts": lig_contacts,
            "lig_summary": summarize_contacts(lig_contacts),
            "secondary_O_contacts": secO_contacts,
            "secondary_O_summary": summarize_contacts(secO_contacts),
            # Includes assigned primary C-O distances by design.
            "O_any_min_distance_including_primary_A": (
                min(raw_o_distances) if raw_o_distances else float("nan")
            ),
        }
    return result


def aggregate_group_results(group_results, key_summary):
    summaries = [x[key_summary] for x in group_results.values()]
    gaps = [s["min_vdw_gap_A"] for s in summaries if not math.isnan(s["min_vdw_gap_A"])]
    dmins = [s["min_distance_A"] for s in summaries if not math.isnan(s["min_distance_A"])]
    return {
        "min_distance_A": min(dmins) if dmins else float("nan"),
        "min_vdw_gap_A": min(gaps) if gaps else float("nan"),
        "vdw_overlap_sum_A": sum(s["vdw_overlap_sum_A"] for s in summaries),
        "n_vdw_overlap": sum(s["n_vdw_overlap"] for s in summaries),
        "n_proximity": sum(s["n_proximity"] for s in summaries),
        "n_pairs": sum(s["n_pairs"] for s in summaries),
    }


