# EDA / PREPARATION TABLE PARSING + COMPARISON
# ============================================================

EDA_CANONICAL_ORDER = [
    "Bond Energy",
    "Orbital Energy",
    "Electrostatic Energy",
    "Pauli Energy",
    "Delta E^0(XC)",
    "Delta Dispersion",
    "Delta G_sol",
    "prep_cat",
    "prep_sub",
    "preparation",
]

EDA_REPORT_LABEL = {
    "Bond Energy": "Bond Energy",
    "Orbital Energy": "Orbital Energy",
    "Electrostatic Energy": "Electrostatic Energy",
    "Pauli Energy": "Pauli Energy",
    "Delta E^0(XC)": "Δ E0(XC)",
    "Delta Dispersion": "ΔEdisp",
    "Delta G_sol": "Δ Gsol",
    "prep_sub": "ΔEdist_sub",
    "prep_cat": "ΔEdist_cat",
    "preparation": "ΔEdist",
}


def _norm_text(x):
    return re.sub(r"\s+", " ", str(x).strip()).lower()


def _canonical_eda_label(label):
    """Canonicalize the exact row labels used in the user's EDA matrix.

    Supported examples (formatting/punctuation may vary):
      Bond Energy
      Orbital Energy
      Electrostatic Energy
      Pauli Energy
      delta E0XC / Δ E0(XC) / Δ E^0_(XC)
      deltaEdisp / ΔE_disp
      delta Gsol / Δ G_sol
      delta Edist_sub / ΔEdist_sub / ΔE_dist_sub
      deltaEdist_cat / ΔEdist_cat / ΔE_dist_cat
      delta Edist / ΔEdist / ΔE_dist

    Matching deliberately ignores spaces, underscores, parentheses, hyphens,
    superscript formatting and whether Delta is written as Δ or 'delta'.
    """
    import unicodedata

    raw = unicodedata.normalize("NFKC", str(label)).strip()
    if not raw:
        return None

    # Normalize common spreadsheet variants before stripping punctuation.
    x = raw
    x = x.replace("Δ", "delta").replace("δ", "delta").replace("∆", "delta")
    x = x.replace("−", "-").replace("–", "-").replace("—", "-")
    x = x.replace("⁰", "0").replace("^0", "0")
    x = x.lower()
    # Keep only ASCII letters/numbers. Thus all of these collapse identically:
    # delta E0(XC), delta_E0XC, Δ E^0_(XC) -> deltae0xc
    token = re.sub(r"[^a-z0-9]+", "", x)

    table = {
        "bondenergy": "Bond Energy",
        "orbitalenergy": "Orbital Energy",
        "electrostaticenergy": "Electrostatic Energy",
        "paulienergy": "Pauli Energy",
        "deltae0xc": "Delta E^0(XC)",
        "de0xc": "Delta E^0(XC)",
        "deltaedisp": "Delta Dispersion",
        "deltaedispersion": "Delta Dispersion",
        "dedisp": "Delta Dispersion",
        "deltagsol": "Delta G_sol",
        "dgsol": "Delta G_sol",
        "deltaedistsub": "prep_sub",
        "edistsub": "prep_sub",
        "deltadistsub": "prep_sub",
        "deltaedistcat": "prep_cat",
        "edistcat": "prep_cat",
        "deltadistcat": "prep_cat",
        "deltaedist": "preparation",
        "edist": "preparation",
        "deltadist": "preparation",
        # internal/output aliases
        "prepsub": "prep_sub",
        "prepcat": "prep_cat",
        "preparation": "preparation",
    }
    return table.get(token)


def _to_float(cell):
    """Read a number robustly from an Excel/CSV cell.

    Accepts normal floats and cells with accidental trailing symbols, e.g.
    '61.22Δ'.  Commas and Unicode minus signs are normalized.  The first
    numeric token is used; non-numeric cells return None.
    """
    if cell is None:
        return None
    t = str(cell).strip()
    if not t:
        return None
    t = t.replace("−", "-").replace("–", "-").replace("—", "-").replace(",", "")
    m = re.search(r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?", t)
    if not m:
        return None
    try:
        return float(m.group(0))
    except ValueError:
        return None

def _clean_structure_token(token):
    t = str(token).strip().replace("\\", "/")
    if not t:
        return ""
    # Rows such as new/con_R_Q23_cat should resolve to con_R_Q23_cat.
    return t.split("/")[-1]


def parse_eda_table(path, known_structures):
    """
    Parse either:
      1) a matrix block with a structure-name header and energy rows, like the
         current EDA table; optionally followed by name_sub / name_cat rows; or
      2) a tidy CSV with a 'structure' column and named energy/prep columns.

    Exact structure names are required.  step_S_Q3 is never silently equated to
    step_S_Q4 (or any other near-match).
    """
    with open(path, newline="", encoding="utf-8-sig") as f:
        rows = list(csv.reader(f))
    if not rows:
        raise RuntimeError(f"EDA table is empty: {path}")

    known = set(known_structures)
    data = {name: {} for name in known_structures}

    # ---------- tidy-table attempt ----------
    header_idx = None
    structure_col = None
    for ir, row in enumerate(rows[:50]):
        for ic, cell in enumerate(row):
            if _norm_text(cell) == "structure":
                header_idx, structure_col = ir, ic
                break
        if header_idx is not None:
            break
    if header_idx is not None:
        hdr = rows[header_idx]
        canon_cols = {}
        prep_cat_col = prep_sub_col = prep_total_col = None
        for ic, h in enumerate(hdr):
            nh = _norm_text(h).replace("-", "_").replace(" ", "_")
            can = _canonical_eda_label(h)
            if can:
                canon_cols[ic] = can
            if nh in {"prep_cat", "preparation_cat", "cat_preparation", "catalyst_preparation", "catalyst_distortion"}:
                prep_cat_col = ic
            elif nh in {"prep_sub", "preparation_sub", "sub_preparation", "substrate_preparation", "substrate_distortion"}:
                prep_sub_col = ic
            elif nh in {"prep_total", "preparation_total", "total_preparation", "total_distortion"}:
                prep_total_col = ic
        for row in rows[header_idx+1:]:
            if structure_col >= len(row):
                continue
            name = _clean_structure_token(row[structure_col])
            if name not in known:
                continue
            for ic, can in canon_cols.items():
                if ic < len(row):
                    val = _to_float(row[ic])
                    if val is not None:
                        data[name][can] = val
            for ic, key in ((prep_cat_col, "prep_cat"), (prep_sub_col, "prep_sub"),
                            (prep_total_col, "preparation")):
                if ic is not None and ic < len(row):
                    val = _to_float(row[ic])
                    if val is not None:
                        data[name][key] = val

    # ---------- scan matrix-style energy blocks ----------
    # Any row containing >=2 exact known structure names can act as a matrix header.
    for ir, row in enumerate(rows):
        positions = {}
        for ic, cell in enumerate(row):
            name = _clean_structure_token(cell)
            if name in known:
                positions[ic] = name
        if len(positions) < 2:
            continue
        # Scan following rows until another name header / a long blank region.
        for rr in rows[ir+1:min(len(rows), ir+50)]:
            # The user's EDA matrix has the descriptor in the first non-empty
            # cell of each row. Read that cell literally, then take values from
            # the structure columns of the header above.
            # Find the descriptor label anywhere in the row rather than assuming
            # it is the first non-empty cell. This supports spreadsheets with a
            # blank column A and descriptors in column B (as in the current table).
            label = None
            label_cell = ""
            for c in rr:
                candidate = _canonical_eda_label(c)
                if candidate is not None:
                    label = candidate
                    label_cell = c
                    break
            if label is None:
                continue
            for ic, name in positions.items():
                if ic < len(rr):
                    val = _to_float(rr[ic])
                    if val is not None:
                        data[name][label] = val

    # ---------- scan name_cat / name_sub scalar rows anywhere ----------
    for row in rows:
        for ic, cell in enumerate(row):
            token = _clean_structure_token(cell)
            m = re.fullmatch(r"(.+?)_(cat|sub)", token, flags=re.IGNORECASE)
            if not m:
                continue
            name, frag = m.group(1), m.group(2).lower()
            if name not in known:
                continue
            val = None
            for cc in row[ic+1:]:
                val = _to_float(cc)
                if val is not None:
                    break
            if val is not None:
                data[name]["prep_cat" if frag == "cat" else "prep_sub"] = val

    # If total preparation is absent but cat/sub are available, calculate it.
    for name, d in data.items():
        if "preparation" not in d and "prep_cat" in d and "prep_sub" in d:
            d["preparation"] = d["prep_cat"] + d["prep_sub"]
        if "preparation" in d and "prep_cat" in d and "prep_sub" in d:
            d["prep_closure_error"] = d["preparation"] - d["prep_cat"] - d["prep_sub"]

    # Short diagnostic: useful when spreadsheet row labels use symbols/abbreviations.
    for name in known_structures:
        found = [k for k in EDA_CANONICAL_ORDER if k in data.get(name, {})]
        if found:
            print(f"EDA recognized for {name}: " + ", ".join(EDA_REPORT_LABEL.get(k, k) for k in found))
        missing = [k for k in EDA_CANONICAL_ORDER if k not in data.get(name, {})]
        if missing:
            print(f"EDA missing for {name}: " + ", ".join(EDA_REPORT_LABEL.get(k, k) for k in missing))

    return data


def _prep_dominance(cat, sub):
    if cat is None or sub is None:
        return "insufficient_data"
    ac, ass = abs(cat), abs(sub)
    if abs(ac - ass) <= DISTORTION_EQUAL_TOL:
        return "equal"
    return "catalyst" if ac > ass else "substrate"


def write_eda_and_distortion_outputs(selected_names, eda_data):
    # Selected absolute values.
    fields = ["structure"] + EDA_CANONICAL_ORDER + [
        "prep_closure_error", "prep_dominant_fragment_absolute",
        "prep_cat_fraction_of_cat_plus_sub_pct",
    ]
    with open(EDA_SELECTED_OUT, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=fields)
        w.writeheader()
        for name in selected_names:
            d = eda_data.get(name, {})
            cat = d.get("prep_cat")
            sub = d.get("prep_sub")
            denom = (cat + sub) if cat is not None and sub is not None else None
            row = {"structure": name, **d}
            row["prep_dominant_fragment_absolute"] = _prep_dominance(cat, sub)
            row["prep_cat_fraction_of_cat_plus_sub_pct"] = (
                100.0 * cat / denom if denom not in (None, 0.0) else ""
            )
            w.writerow({k: fmt(row.get(k, "")) for k in fields})

    # Pairwise differences, always A - B in the user-specified selection order.
    pair_fields = ["structure_A", "structure_B", "comparison"] + [
        f"delta_{x.replace(' ', '_')}" for x in EDA_CANONICAL_ORDER
    ] + [
        "delta_prep_total_from_cat_plus_sub",
        "prep_difference_dominant_fragment",
        "abs_delta_prep_cat", "abs_delta_prep_sub",
    ]
    pair_rows = []
    for a, b in itertools.combinations(selected_names, 2):
        da, db = eda_data.get(a, {}), eda_data.get(b, {})
        row = {"structure_A": a, "structure_B": b, "comparison": f"{a} - {b}"}
        for key in EDA_CANONICAL_ORDER:
            va, vb = da.get(key), db.get(key)
            row[f"delta_{key.replace(' ', '_')}"] = (
                va - vb if va is not None and vb is not None else ""
            )
        dcat = (da.get("prep_cat") - db.get("prep_cat")
                if da.get("prep_cat") is not None and db.get("prep_cat") is not None else None)
        dsub = (da.get("prep_sub") - db.get("prep_sub")
                if da.get("prep_sub") is not None and db.get("prep_sub") is not None else None)
        row["delta_prep_cat"] = "" if dcat is None else dcat
        row["delta_prep_sub"] = "" if dsub is None else dsub
        row["delta_prep_total_from_cat_plus_sub"] = (
            "" if dcat is None or dsub is None else dcat + dsub
        )
        row["prep_difference_dominant_fragment"] = _prep_dominance(dcat, dsub)
        row["abs_delta_prep_cat"] = "" if dcat is None else abs(dcat)
        row["abs_delta_prep_sub"] = "" if dsub is None else abs(dsub)
        pair_rows.append(row)

    with open(EDA_PAIRWISE_OUT, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=pair_fields)
        w.writeheader()
        for row in pair_rows:
            w.writerow({k: fmt(row.get(k, "")) for k in pair_fields})

    # A compact distortion-only table for quick reading.
    dist_fields = [
        "scope", "structure_A", "structure_B", "value_cat", "value_sub",
        "value_total", "dominant_fragment_by_absolute_magnitude", "definition",
    ]
    dist_rows = []
    for name in selected_names:
        d = eda_data.get(name, {})
        cat, sub = d.get("prep_cat"), d.get("prep_sub")
        total = d.get("preparation")
        if total is None and cat is not None and sub is not None:
            total = cat + sub
        dist_rows.append({
            "scope": "absolute_structure",
            "structure_A": name,
            "structure_B": "",
            "value_cat": "" if cat is None else cat,
            "value_sub": "" if sub is None else sub,
            "value_total": "" if total is None else total,
            "dominant_fragment_by_absolute_magnitude": _prep_dominance(cat, sub),
            "definition": "absolute preparation/distortion energy for this structure",
        })
    for row in pair_rows:
        dcat = _to_float(row["delta_prep_cat"])
        dsub = _to_float(row["delta_prep_sub"])
        dist_rows.append({
            "scope": "pairwise_A_minus_B",
            "structure_A": row["structure_A"],
            "structure_B": row["structure_B"],
            "value_cat": "" if dcat is None else dcat,
            "value_sub": "" if dsub is None else dsub,
            "value_total": "" if dcat is None or dsub is None else dcat + dsub,
            "dominant_fragment_by_absolute_magnitude": _prep_dominance(dcat, dsub),
            "definition": "A-B preparation difference; dominance compares |delta cat| vs |delta sub|",
        })
    with open(DISTORTION_SUMMARY_OUT, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=dist_fields)
        w.writeheader()
        for row in dist_rows:
            w.writerow({k: fmt(row.get(k, "")) for k in dist_fields})

    return pair_rows


def add_eda_and_isolated_metrics_to_model_rows(model_rows, eda_data, isolated_metrics):
    for row in model_rows:
        name = row["structure"]
        for key, value in isolated_metrics.get(name, {}).items():
            row[key] = value
        for key, value in eda_data.get(name, {}).items():
            row[f"EDA_{key.replace(' ', '_')}"] = value
        cat = eda_data.get(name, {}).get("prep_cat")
        sub = eda_data.get(name, {}).get("prep_sub")
        row["EDA_prep_dominant_fragment"] = _prep_dominance(cat, sub)

    # Rewrite the main model table after augmentation.
    fields, seen = [], set()
    for row in model_rows:
        for k in row:
            if k not in seen:
                seen.add(k); fields.append(k)
    with open(MODEL_OUT, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=fields)
        w.writeheader()
        for row in model_rows:
            w.writerow({k: fmt(row.get(k, "")) for k in fields})


