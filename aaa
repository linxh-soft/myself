        row["phenyl_centroid_y_A"] = phenyl_centroid[1]
        row["phenyl_centroid_z_A"] = phenyl_centroid[2]

        # V12: true fragment RMSDs and phenyl-ligand buried contact area.
        row.update(fragment_rmsd_descriptors(
            ref_atoms, atoms, mappings[name], ligand_mappings[name], phenyl_ring_ref
        ))
        row.update(phenyl_ligand_contact_area_descriptors(atoms, phenyl_ring_indices))

        for label, meta in methyl_meta_by_structure.get(name, {}).items():
            md = methyl_group_descriptors(atoms, meta, fi, phenyl_ring_indices)
            methyl_results[label] = md

            clean = label.replace(" ", "_")
            row[f"{clean}_methylC_index"] = md["center_idx"]
            row[f"{clean}_anchor_index"] = md["anchor_idx"]
            row[f"{clean}_methylC_to_forming_C1_A"] = md["methylC_to_forming_C1_A"]
