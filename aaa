# SUBSTRATE PHENYL-RING REFERENCE
# ============================================================

def _canonical_cycle(cycle):
    """Canonical tuple for one ordered simple cycle, invariant to rotation/reversal."""
    cyc = list(cycle)
    n = len(cyc)
    variants = []
    for arr in (cyc, list(reversed(cyc))):
        for k in range(n):
            variants.append(tuple(arr[k:] + arr[:k]))
    return min(variants)


def find_six_carbon_cycles(atoms):
    """
    Find ordered simple six-member cycles made only of substrate carbon atoms.
    This is a connectivity detector, not an aromaticity calculation.
    """
    graph, ad = build_graph(atoms)
    cycles = set()

    carbon_nodes = [i for i in graph if ad[i]["element"] == "C"]

    def dfs(start, current, path):
        if len(path) == 6:
            if start in graph[current]:
                cycles.add(_canonical_cycle(path))
            return
        for nb in graph[current]:
            if ad[nb]["element"] != "C":
                continue
            if nb == start or nb in path:
                continue
            dfs(start, nb, path + [nb])

    for start in carbon_nodes:
        dfs(start, start, [start])

    return sorted(cycles)


def shortest_graph_distance(graph, starts, targets):
    """Minimum number of bonds between any start and any target."""
    starts = set(starts)
    targets = set(targets)
    if starts & targets:
        return 0
    frontier = list(starts)
    seen = set(starts)
    dist = 0
    while frontier:
        dist += 1
        nxt = []
        for node in frontier:
            for nb in graph[node]:
                if nb in seen:
                    continue
                if nb in targets:
                    return dist
                seen.add(nb)
                nxt.append(nb)
        frontier = nxt
    return 10**9


def resolve_phenyl_ring_ref(ref_atoms, forming_c_ref):
    """
    Resolve the phenyl-ring carbon indices in REFERENCE numbering.
    Manual PHENYL_RING_REF wins.  Auto mode finds six-member all-carbon cycles
    and, if there is more than one, chooses the cycle with the smallest graph
    distance to the forming alkene carbons.
    """
    ad = atom_dict(ref_atoms)
    graph, _ = build_graph(ref_atoms)

    if PHENYL_RING_REF is not None:
        raw_ring = tuple(PHENYL_RING_REF)
        if len(raw_ring) != 6 or len(set(raw_ring)) != 6:
            raise RuntimeError("PHENYL_RING_REF must contain six unique atom indices")
        for i in raw_ring:
            if i not in ad or ad[i]["element"] != "C" or i < SUB_START:
                raise RuntimeError(f"PHENYL_RING_REF contains a missing/non-substrate/non-carbon atom: {i}")

        # Accept the six ring atoms in ANY order.  Build the induced subgraph and
        # reorder them into cyclic bonded order automatically.
        ring_set = set(raw_ring)
        local_neigh = {i: sorted(nb for nb in graph[i] if nb in ring_set) for i in raw_ring}
        bad = {i: nbs for i, nbs in local_neigh.items() if len(nbs) != 2}
        if bad:
            details = "; ".join(f"C{i}: {','.join('C'+str(x) for x in nbs) or 'none'}"
                                for i, nbs in sorted(bad.items()))
            raise RuntimeError(
                "The six atoms in PHENYL_RING_REF do not form one simple six-member carbon ring. "
                "Within the selected set, every ring carbon must have exactly two ring neighbors. "
                f"Problematic connectivity: {details}"
            )

        start = min(raw_ring)
        first = local_neigh[start][0]
        ordered = [start, first]
        prev, cur = start, first
        while len(ordered) < 6:
            choices = [x for x in local_neigh[cur] if x != prev]
            if len(choices) != 1:
                raise RuntimeError("Could not uniquely order PHENYL_RING_REF into a six-member cycle")
            nxt = choices[0]
            if nxt in ordered:
                raise RuntimeError("PHENYL_RING_REF closes a cycle before all six atoms are visited")
            ordered.append(nxt)
            prev, cur = cur, nxt
        if start not in local_neigh[ordered[-1]]:
            raise RuntimeError("PHENYL_RING_REF does not close into a six-member cycle")

        ring = tuple(ordered)
        return ring, [ring], "manual_autoordered"

    candidates = find_six_carbon_cycles(ref_atoms)
    if not candidates:
        raise RuntimeError(
            "No six-member all-carbon substrate ring was auto-detected. "
            "Set PHENYL_RING_REF manually."
        )

    if len(candidates) == 1:
        return candidates[0], candidates, "auto_unique"

    scored = []
    for ring in candidates:
        d = shortest_graph_distance(graph, forming_c_ref, ring)
        scored.append((d, ring))
    scored.sort(key=lambda x: (x[0], x[1]))
    return scored[0][1], candidates, "auto_nearest_to_forming_C"


def mapped_ring_indices(mapping, ring_ref):
    return [mapping[i] for i in ring_ref]


def ring_centroid_and_normal(atoms, ordered_ring_indices):
    """
    Return centroid and a unit normal for an ordered six-member ring.
    The normal sign is arbitrary; absolute plane distances/angles are used.
    """
    ad = atom_dict(atoms)
    pts = [atom_point(ad[i]) for i in ordered_ring_indices]
    cen = (
        sum(p[0] for p in pts) / len(pts),
        sum(p[1] for p in pts) / len(pts),
        sum(p[2] for p in pts) / len(pts),
    )
    nvec = (0.0, 0.0, 0.0)
    for i in range(len(pts)):
        v1 = (pts[i][0]-cen[0], pts[i][1]-cen[1], pts[i][2]-cen[2])
        p2 = pts[(i+1) % len(pts)]
        v2 = (p2[0]-cen[0], p2[1]-cen[1], p2[2]-cen[2])
        c = _cross(v1, v2)
        nvec = (nvec[0]+c[0], nvec[1]+c[1], nvec[2]+c[2])
    nn = _norm(nvec)
    if nn < 1e-12:
        return cen, (float("nan"), float("nan"), float("nan"))
    return cen, _scale(nvec, 1.0/nn)


def point_abs_distance_to_plane(point, plane_point, unit_normal):
    if any(math.isnan(x) for x in unit_normal):
        return float("nan")
    rel = (point[0]-plane_point[0], point[1]-plane_point[1], point[2]-plane_point[2])
    return abs(_dot(rel, unit_normal))


def angle_axis_to_plane_deg(axis_vec, unit_normal):
    """Acute angle between an axis and a plane: 0=in plane, 90=normal to plane."""
    na = _norm(axis_vec)
    if na < 1e-12 or any(math.isnan(x) for x in unit_normal):
        return float("nan")
    cos_to_normal = abs(_dot(_scale(axis_vec, 1.0/na), unit_normal))
    cos_to_normal = max(0.0, min(1.0, cos_to_normal))
    angle_to_normal = math.degrees(math.acos(cos_to_normal))
    return 90.0 - angle_to_normal


def write_phenyl_ring_mapping(structures, mappings, ring_ref, candidates, mode):
    fields = ["structure", "reference_ring_atoms", "mapped_ring_atoms", "selection_mode", "candidate_rings_in_reference"]
    cand = " | ".join(";".join(map(str, c)) for c in candidates)
    with open(PHENYL_RING_OUT, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=fields)
        w.writeheader()
        for name in structures:
            w.writerow({
                "structure": name,
                "reference_ring_atoms": ";".join(map(str, ring_ref)),
                "mapped_ring_atoms": ";".join(map(str, mapped_ring_indices(mappings[name], ring_ref))),
                "selection_mode": mode,
                "candidate_rings_in_reference": cand,
            })


