def write_model_descriptors(structures, mappings, mapping_meta, groups,
                            subheavy_results, suball_results, forming_infos,
                            methyl_meta_by_structure, phenyl_ring_ref,
                            ligand_mappings, reference_atoms):
    rows = []
    ref_atoms = reference_atoms

    for name, atoms in structures.items():
        fi = forming_infos[name]
        score, nmaps = mapping_meta[name]

        sh_lig = aggregate_group_results(subheavy_results[name], "lig_summary")
        sa_lig = aggregate_group_results(suball_results[name], "lig_summary")
        sh_o = aggregate_group_results(subheavy_results[name], "secondary_O_summary")
        sa_o = aggregate_group_results(suball_results[name], "secondary_O_summary")

        all_sub_indices = [a["index"] for a in substrate_atoms(atoms)]
        secO_all = build_contact_list(
            atoms, all_sub_indices, reactive_oxygen_atoms(atoms),
            skip_pairs=fi["primary_pairs"]
        )

        sec_by_class = {
            "H": summarize_contacts(contacts_for_sub_element(secO_all, "H")),
            "C": summarize_contacts(contacts_for_sub_element(secO_all, "C")),
            "N": summarize_contacts(contacts_for_sub_element(secO_all, "N")),
            "other": summarize_contacts(contacts_for_other_elements(secO_all)),
        }

        row = {
            "structure": name,
            "mechanism": mechanism_label(name),
            "stereo": stereo_label(name),
            "mapping_distance_matrix_RMS_A": score,
            "n_graph_mappings": nmaps,
            "forming_ref_C1": fi["ref_C1"],
            "forming_ref_C2": fi["ref_C2"],
            "forming_mapped_C1": fi["mapped_C1"],
            "forming_mapped_C2": fi["mapped_C2"],
            "forming_O_on_C1": fi["O_on_C1"],
            "forming_O_on_C2": fi["O_on_C2"],
            "forming_C1O_distance_A": fi["C1O_distance_A"],
            "forming_C2O_distance_A": fi["C2O_distance_A"],
            "forming_pairing_mode": fi["pairing_mode"],
            "pairing_swapped": fi["pairing_swapped"],
