def parse_args():
    p = argparse.ArgumentParser(
        description=(
            "V12.5 geometry/contact + isolated-fragment deformation + EDA + Chinese report. "
            "Choose two, several, or all structures."
        )
    )
    p.add_argument(
        "--structures", nargs="+", default=None,
        help="Exact structure names to compare, e.g. --structures con_S step_R. Default: all."
    )
    p.add_argument("--all", action="store_true", help="Analyze all structures in FILES.")
    p.add_argument("--eda", default=EDA_TABLE, help=f"EDA/preparation CSV (default: {EDA_TABLE})")
    p.add_argument("--cat-ref", default=CAT_REFERENCE_XYZ,
                   help=f"isolated catalyst XYZ (default: {CAT_REFERENCE_XYZ})")
    p.add_argument("--sub-ref", default=SUB_REFERENCE_XYZ,
                   help=f"isolated substrate XYZ (default: {SUB_REFERENCE_XYZ})")
    p.add_argument("--outdir", default=None,
                   help="output directory; default is v12_5_compare_<selected names>")
    p.add_argument("--list-structures", action="store_true", help="print available names and exit")
    return p.parse_args()


# ============================================================
# MAIN
# ============================================================

def main():
    global CAT_REFERENCE_XYZ, SUB_REFERENCE_XYZ, EDA_TABLE

    args = parse_args()
    if args.list_structures:
        print("Available structures:")
        for name, fn in FILES.items():
            print(f"  {name:12s}  {fn}")
        return

    if args.all or args.structures is None:
        selected_names = list(FILES.keys())
    else:
        selected_names = args.structures
    # Preserve user order, remove accidental duplicates.
    selected_names = list(dict.fromkeys(selected_names))
    unknown = [x for x in selected_names if x not in FILES]
    if unknown:
        raise SystemExit(
            "Unknown structure(s): " + ", ".join(unknown) +
            "\nAvailable: " + ", ".join(FILES)
        )
    if not selected_names:
        raise SystemExit("No structures selected")

    start_dir = Path.cwd()
    CAT_REFERENCE_XYZ = str(Path(args.cat_ref).expanduser().resolve())
    SUB_REFERENCE_XYZ = str(Path(args.sub_ref).expanduser().resolve())
    EDA_TABLE = str(Path(args.eda).expanduser().resolve())

    # Load mapping reference even when it is not one of the requested outputs.
    needed = list(dict.fromkeys(selected_names + [REFERENCE]))
    working_structures = {}
    for name in needed:
        p = Path(FILES[name]).expanduser().resolve()
        if not p.exists():
            raise FileNotFoundError(f"Missing XYZ for {name}: {p}")
        working_structures[name] = read_xyz(str(p))

    for p in (Path(CAT_REFERENCE_XYZ), Path(SUB_REFERENCE_XYZ), Path(EDA_TABLE)):
        if not p.exists():
            raise FileNotFoundError(p)
    cat_ref_atoms = read_xyz(CAT_REFERENCE_XYZ)
    sub_ref_atoms = read_xyz(SUB_REFERENCE_XYZ)
    eda_data = parse_eda_table(EDA_TABLE, list(FILES.keys()))

    # Strict check: the current EDA matrix is expected to contain all ten rows
    # for every selected structure. Do not silently continue to an NA report.
    required_eda = list(EDA_CANONICAL_ORDER)
    selected_for_check = selected_names if 'selected_names' in locals() else list(FILES.keys())
    problems = []
    for _name in selected_for_check:
        _missing = [k for k in required_eda if k not in eda_data.get(_name, {})]
        if _missing:
            problems.append((_name, _missing))
    if problems:
        msg = ["EDA parsing failed: required rows are missing for selected structure(s):"]
        for _name, _missing in problems:
            msg.append("  " + _name + ": " + ", ".join(EDA_REPORT_LABEL.get(k, k) for k in _missing))
        msg.append("Expected row labels include: Bond Energy, Orbital Energy, Electrostatic Energy, Pauli Energy, delta E0XC, deltaEdisp, delta Gsol, delta Edist_sub, deltaEdist_cat, delta Edist")
        raise RuntimeError("\n".join(msg))

    ref_atoms = working_structures[REFERENCE]
    groups, nautos = symmetry_groups(ref_atoms)

    # Mapping metadata is generated using the fixed chemical mapping reference.
    ref_methyl_meta_by_label, methyl_candidates = resolve_methyl_groups(ref_atoms)
    methyl_meta_working, ligand_mapping_meta, ligand_mappings = \
        map_named_methyls_to_structures(working_structures, ref_methyl_meta_by_label)

    if FORMING_C_REF is None:
        forming_c_ref = auto_detect_forming_c_ref(ref_atoms)
        forming_auto = True
    else:
        forming_c_ref = tuple(FORMING_C_REF)
        forming_auto = False

    ref_graph, _ = build_graph(ref_atoms)
    mappings = {REFERENCE: {i: i for i in ref_graph}}
    mapping_meta = {REFERENCE: (0.0, 1)}
    for name, atoms in working_structures.items():
        if name == REFERENCE:
            continue
        m, score, nmaps = best_mapping(ref_atoms, atoms)
        mappings[name] = m
        mapping_meta[name] = (score, nmaps)

    phenyl_ring_ref, phenyl_candidates, phenyl_mode = resolve_phenyl_ring_ref(ref_atoms, forming_c_ref)

    # From here onward, output only the explicitly selected structures.
    structures = {name: working_structures[name] for name in selected_names}
    methyl_meta_by_structure = {name: methyl_meta_working[name] for name in selected_names}

    forming_infos = {
        name: forming_bond_descriptors(atoms, mappings[name], forming_c_ref)
        for name, atoms in structures.items()
    }
    subheavy_results = {
        name: group_analysis(atoms, mappings[name], groups, forming_infos[name], include_sub_H=False)
        for name, atoms in structures.items()
    }
    suball_results = {
        name: group_analysis(atoms, mappings[name], groups, forming_infos[name], include_sub_H=True)
        for name, atoms in structures.items()
    }

    # Create output directory only after all input files have been resolved/read.
    if args.outdir:
        outdir = Path(args.outdir).expanduser().resolve()
    else:
        tag = "all" if len(selected_names) == len(FILES) else "__".join(selected_names)
        outdir = (start_dir / f"v12_5_compare_{tag}").resolve()
    outdir.mkdir(parents=True, exist_ok=True)
    os.chdir(outdir)

    # V12.5 retains the full V11 geometry/contact analysis for selected structures.
    write_symmetry_files(ref_atoms, groups, nautos)
    write_methyl_candidates(ref_atoms, ref_methyl_meta_by_label, methyl_candidates)
    write_methyl_mapping_report(methyl_meta_by_structure, {
        n: ligand_mapping_meta[n] for n in selected_names
    })
    write_phenyl_ring_mapping(structures, mappings, phenyl_ring_ref, phenyl_candidates, phenyl_mode)

    with open("mapping_report_v12_5.txt", "w", encoding="utf-8") as report:
        report.write(f"Mapping reference: {REFERENCE}\n")
        report.write("Only selected structures are listed below.\n")
        report.write("Isolated substrate atom order is auto-mapped in V12.5.\n")
        report.write("Score = RMS difference of mapped substrate heavy-atom internal pair distances; NOT Kabsch RMSD.\n")
        for name in selected_names:
            score, nmaps = mapping_meta[name]
            report.write(f"{name}: {nmaps} mapping(s), distance-matrix RMS = {score:.6f} A\n")

    write_group_table(
        subheavy_results, GROUPS_SUBHEAVY_OUT,
        "substrate heavy atoms vs all ligand atoms; secondary O contacts exclude only assigned primary C-O pairs",
    )
    write_group_table(
        suball_results, GROUPS_SUBALL_OUT,
        "all substrate atoms vs all ligand atoms; secondary O contacts exclude only assigned primary C-O pairs",
    )
    write_primary_pairs(structures, forming_infos)
    write_long_secondary_O_contacts(structures, forming_infos)
    write_long_ligand_contacts(structures)
    write_long_methyl_contacts(structures, methyl_meta_by_structure)

    model_rows = write_model_descriptors(
        structures, mappings, mapping_meta, groups,
        subheavy_results, suball_results, forming_infos,
        methyl_meta_by_structure, phenyl_ring_ref, ligand_mappings,
        ref_atoms,
    )

    # Atom-resolved deformation is now vs isolated fragments, not another TS.
    isolated_metrics, deformation_core_ids, deformation_core_mode = isolated_fragment_deformation(
        structures, mappings, ligand_mappings,
        ref_atoms, cat_ref_atoms, sub_ref_atoms,
    )

