    out_fields = ["descriptor", "category_cn", "unit", "chinese_annotation", "caution_cn"]
    with open(DESCRIPTOR_CN_OUT, "w", newline="", encoding="utf-8-sig") as f:
        w = csv.DictWriter(f, fieldnames=out_fields)
        w.writeheader()
        for field in fields:
            cat, unit, desc, caution = descriptor_annotation_cn(field)
            w.writerow({
                "descriptor": field,
                "category_cn": cat,
                "unit": unit,
                "chinese_annotation": desc,
                "caution_cn": caution,
            })


def _numeric_or_none(v):
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        if isinstance(v, float) and math.isnan(v):
            return None
        return float(v)
    return _to_float(v)


def write_pairwise_descriptor_differences(selected_names, model_rows):
    by_name = {r["structure"]: r for r in model_rows}
    all_fields = []
    seen = set()
    for r in model_rows:
        for k in r:
            if k not in seen:
                seen.add(k); all_fields.append(k)
    out_fields = [
        "comparison", "structure_A", "structure_B", "category_cn", "descriptor",
        "unit", "chinese_annotation", "A_value", "B_value", "delta_A_minus_B", "caution_cn",
    ]
    rows = []
    for a, b in itertools.combinations(selected_names, 2):
        ra, rb = by_name[a], by_name[b]
        for field in all_fields:
            va = _numeric_or_none(ra.get(field))
            vb = _numeric_or_none(rb.get(field))
            if va is None or vb is None:
                continue
            cat, unit, desc, caution = descriptor_annotation_cn(field)
            rows.append({
                "comparison": f"{a} - {b}", "structure_A": a, "structure_B": b,
                "category_cn": cat, "descriptor": field, "unit": unit,
                "chinese_annotation": desc, "A_value": va, "B_value": vb,
                "delta_A_minus_B": va-vb, "caution_cn": caution,
            })
    with open(PAIRWISE_DESCRIPTOR_OUT, "w", newline="", encoding="utf-8-sig") as f:
        w = csv.DictWriter(f, fieldnames=out_fields)
        w.writeheader()
        for r in rows:
            w.writerow({k: fmt(r.get(k, "")) for k in out_fields})


