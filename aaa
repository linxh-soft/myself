            "CO_long_A": fi["CO_long_A"],
            "CO_mean_A": fi["CO_mean_A"],
            "CO_sum_A": fi["CO_sum_A"],
            "CO_asym_A": fi["CO_asym_A"],
            "OCCO_dihedral_signed_deg": fi["OCCO_dihedral_signed_deg"],
            "OCCO_dihedral_abs_deg": fi["OCCO_dihedral_abs_deg"],
            "OCCO_twist_from_coplanar_deg": fi["OCCO_twist_from_coplanar_deg"],
        }

        add_contact_summary_fields(row, "subheavy_ligall", sh_lig)
        add_contact_summary_fields(row, "suball_ligall", sa_lig)
        add_contact_summary_fields(row, "subheavy_secondaryO", sh_o)
        add_contact_summary_fields(row, "suball_secondaryO", sa_o)

        for cls, summary in sec_by_class.items():
            add_contact_summary_fields(row, f"secondaryO_to_{cls}", summary)

        # --------------------------------------------------------
        # Two named ligand methyl groups vs substrate.
        # CH3 contact summaries are neutral proximity descriptors.
        # Methyl-carbon distances track placement of the reaction center.
        # --------------------------------------------------------
        methyl_results = {}
        phenyl_ring_indices = mapped_ring_indices(mappings[name], phenyl_ring_ref)
        phenyl_centroid, phenyl_normal = ring_centroid_and_normal(atoms, phenyl_ring_indices)
        row["phenyl_ring_mapped_atoms"] = ";".join(map(str, phenyl_ring_indices))
